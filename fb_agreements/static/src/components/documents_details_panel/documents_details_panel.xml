<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-inherit="documents.DocumentsDetailsPanel" t-inherit-mode="extension">
        <xpath expr="//div[contains(concat(' ', @class, ' '), ' o_field_widget ')][DocumentsDetailsMany2OneField[@name=&quot;'partner_id'&quot;]]" position="after">
            <i class="fa fa-handshake-o mx-1 my-2" title="Convenio"/>
            <div class="o_field_widget o_field_many2one">
                <DocumentsDetailsMany2OneField
                    name="'fb_agreement_id'"
                    readonly="userPermissionViewOnly"
                    record="record"
                    canOpen="false"
                    canCreate="true"
                    canQuickCreate="false"
                    canCreateEdit="false"
                    placeholder.translate=" Agregar Convenio"
                />
            </div>

        </xpath>
    </t>

</templates>