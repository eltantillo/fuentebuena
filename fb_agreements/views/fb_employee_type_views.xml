<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fb_employee_type_tree" model="ir.ui.view">
        <field name="name">fb.employee.type.list</field>
        <field name="model">fb.employee.type</field>
        <field name="arch" type="xml">
            <list string="Tipos de Empleado" editable="bottom">
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="action_fb_employee_type" model="ir.actions.act_window">
        <field name="name">Tipos de Empleado</field>
        <field name="res_model">fb.employee.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
