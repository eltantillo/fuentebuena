<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="document_view_kanban_inherit_fb" model="ir.ui.view">
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.document_view_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fb_agreement_id"/>
            </xpath>
        </field>
    </record>

    <record id="documents_view_list_main_inherit_fb" model="ir.ui.view">
        <field name="model">documents.document</field>
        <field name="inherit_id" ref="documents.documents_view_list_main"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fb_agreement_id"/>
            </xpath>
        </field>
    </record>
</odoo>