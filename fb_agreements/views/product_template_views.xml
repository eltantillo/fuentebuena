<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_template_form_view_inherit_agreements" model="ir.ui.view">
        <field name="name">product.template.form.inherit.agreements</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position="inside">
                <span class="d-inline-block">
                    <field name="fb_available_in_agreements"/>
                    <label for="fb_available_in_agreements"/>
                </span>
            </xpath>
        </field>
    </record>

</odoo>