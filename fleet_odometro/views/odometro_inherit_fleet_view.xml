<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="odometro_inherit_fleet_view_form" model="ir.ui.view">
        <field name="name">odometro.inherit.fleet.view.form</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/header/button[@name='action_accept_driver_change']" position="before">
                <field name="mostrar_actualizar_odometro" invisible="1"/>
                <button name="odometro_actualizar"
                        string="Actualizar odometro"
                        type="object"
                        class="btn-primary text-white"
                        invisible="mostrar_actualizar_odometro"
                        groups ="fleet_odometro.group_actualizar_odometro,base.group_system"
                        force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>