<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cambiar_hora_view_form" model="ir.ui.view">
            <field name="name">cambiar.hora.view.form</field>
            <field name="model">cambiar.hora</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <p>Está a punto de cambiar la hora de entrega, a continuación ingrese un motivo y la nueva hora</p>
                        </group>
                        <group>
                            <field name="motivo_id" required="1"/>
                        </group>
                        <group>
                            <field name="hora" required="1"/>
                            <field name="minuto" required="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button type="object" name="action_confirm" string="Confirmar" class="btn-success text-white" />
                        <button string="Cancelar" special="cancel"  class="btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>