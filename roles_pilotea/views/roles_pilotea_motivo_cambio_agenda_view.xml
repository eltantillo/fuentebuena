<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="roles_pilotea_motivo_cambio_agenda_view_form"  model="ir.ui.view">
            <field name="name">roles.pilotea.motivo.cambio.agenda.view.form</field>
            <field name="model">rp.motivo.cambio.agenda</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="roles_pilotea_motivo_cambio_agenda_view_list"  model="ir.ui.view">
            <field name="name">roles.pilotea.motivo.cambio.agenda.view.list</field>
            <field name="model">rp.motivo.cambio.agenda</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="roles_pilotea_motivo_cambio_agenda_action" model="ir.actions.act_window">
            <field name="name">Motivos de cambio</field>
            <field name="res_model">rp.motivo.cambio.agenda</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="roles_pilotea_motivo_cambio_agenda_view_list"/>
        </record>
    </data>
</odoo>