<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="roles_pilotea_exclusion_view_form" model="ir.ui.view">
            <field name="name">roles.pilotea.exclusion.view.form</field>
            <field name="model">roles.pilotea.exclusion</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="correo"></field>
                            <field name="tipo_exclusion_ids"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="roles_pilotea_exclusion_view_list" model="ir.ui.view">
            <field name="name">roles.pilotea.exclusion.view.list</field>
            <field name="model">roles.pilotea.exclusion</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="correo"/>
                </list>
            </field>
        </record>

        <record id="roles_pilotea_exclusion_action" model="ir.actions.act_window">
            <field name="name">Exclusiones de correo</field>
            <field name="res_model">roles.pilotea.exclusion</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>