<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="roles_pilotea_exclusion_tipo_view_form" model="ir.ui.view">
            <field name="name">roles.pilotea.exclusion.tipo.view.form</field>
            <field name="model">roles.pilotea.exclusion.tipo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="roles_pilotea_exclusion_tipo_view_list" model="ir.ui.view">
            <field name="name">roles.pilotea.exclusion.tipo.view.list</field>
            <field name="model">roles.pilotea.exclusion.tipo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>


        <record id="roles_pilotea_exclusion_tipo_action" model="ir.actions.act_window">
            <field name="name">Tipo de exclusiones - Correo</field>
            <field name="res_model">roles.pilotea.exclusion.tipo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="roles_pilotea_exclusion_tipo_view_list"/>
        </record>


    </data>
</odoo>