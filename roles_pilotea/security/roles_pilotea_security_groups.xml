            <field name="name">Vehículos - Acceso total</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[
                (6, 0, [
                    ref('group_lider_atencion_cliente'),
                    ref('group_ejecutivo_atencion_cliente'),
                    ref('group_finanzas'),
                    ref('group_credito'),
                    ref('group_coordinador_compra'),
                    ref('group_auxiliar_analista_compra'),
                ])
            ]"/>
        </record>

