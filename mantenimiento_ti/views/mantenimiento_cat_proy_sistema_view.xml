<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="mantenimiento_cat_proy_sistema_view_form" model="ir.ui.view">
            <field name="name">mantenimiento.cat.proy.sistema.view.form</field>
            <field name="model">mantenimiento.cat.proy.sistema</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="proveedor_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mantenimiento_cat_proy_sistema_view_list" model="ir.ui.view">
            <field name="name">mantenimiento.cat.proy.sistema.view.list</field>
            <field name="model">mantenimiento.cat.proy.sistema</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="proveedor_id"/>
                </list>
            </field>
        </record>

        <record id="mantenimiento_cat_proy_sistema_action" model="ir.actions.act_window">
            <field name="name">Mantenimiento - Cat / Proy Sistema</field>
            <field name="res_model">mantenimiento.cat.proy.sistema</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="mantenimiento_cat_proy_sistema_view_list"/>
        </record>
    </data>
</odoo>