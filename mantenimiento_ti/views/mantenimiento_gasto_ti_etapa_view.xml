<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="mantenimiento_gasto_ti_etapa_view_form" model="ir.ui.view">
            <field name="name">mantenimiento.gasto.ti.etapa.view.form</field>
            <field name="model">mantenimiento.gasto.ti.etapa</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="mantenimiento_gasto_ti_etapa_view_list" model="ir.ui.view">
            <field name="name">mantenimiento.gasto.ti.etapa.view.list</field>
            <field name="model">mantenimiento.gasto.ti.etapa</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="mantenimiento_gasto_ti_etapa_action" model="ir.actions.act_window">
            <field name="name">Mantenimiento - Gasto TI / Etapa</field>
            <field name="res_model">mantenimiento.gasto.ti.etapa</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="mantenimiento_gasto_ti_etapa_view_list"/>
        </record>
    </data>
</odoo>