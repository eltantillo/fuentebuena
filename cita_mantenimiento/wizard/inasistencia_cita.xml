<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inasistencia_cita_view_form" model="ir.ui.view">
            <field name="name">inasistencia.cita.view.form</field>
            <field name="model">inasistencia.cita</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <div class="d-flex align-items-center">
                                <div class="alert alert-warning w-100 mb-2" role="alert">
                                    <p>Por favor, proceda con cuidado; las citas seleccionadas pasarán a etapa "Inasistencia".</p>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="etapa_inasistencia_id" invisible="1" readonly="1"/>
                        </group>
                    </sheet>
                    <footer>
                        <button type="object" name="confirmar" string="Confirmar" class="btn-success text-white" />
                        <button string="Cancelar" special="cancel"  class="btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>