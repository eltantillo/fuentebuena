<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cm_inherit_mantenimiento_view_form" model="ir.ui.view">
            <field name="name">cm.inherit.mantenimiento.view.form</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="inherit_id" ref="fleet_mantenimiento.fleet_mantenimiento_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//page[@name='factura']" position="after">
                    <page string="Citas">
                        <field name="cita_ids"/>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>