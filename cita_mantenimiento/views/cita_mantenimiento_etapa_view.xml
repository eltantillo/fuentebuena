<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cita_mantenimiento_etapa_view_form" model="ir.ui.view">
            <field name="name">cita.mantenimiento.etapa.view.form</field>
            <field name="model">cita.mantenimiento.etapa</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <form>
                            <group>
                                <field name="name"/>
                            </group>
                        </form>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="cita_mantenimiento_etapa_view_list" model="ir.ui.view">
            <field name="name">cita.mantenimiento.etapa.view.list</field>
            <field name="model">cita.mantenimiento.etapa</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="cita_mantenimiento_etapa_action" model="ir.actions.act_window">
            <field name="name">Citas de mantenimiento / Etapa</field>
            <field name="res_model">cita.mantenimiento.etapa</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>
</odoo>
