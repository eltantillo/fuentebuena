<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="cm_proveedor_plaza_view_form" model="ir.ui.view">
            <field name="name">cm.proveedor.plaza.view.form</field>
            <field name="model">cm.proveedor.plaza</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="plaza_id"/>
                            <field name="provedoor_ids"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="cm_proveedor_plaza_view_list" model="ir.ui.view">
            <field name="name">cm.proveedor.plaza.view.list</field>
            <field name="model">cm.proveedor.plaza</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="plaza_id"/>
                    <field name="provedoor_ids"/>
                </list>
            </field>
        </record>

        <record id="cm_proveedor_plaza_action" model="ir.actions.act_window">
            <field name="name">CitaMantenimiento - Plaza/Proveedor</field>
            <field name="res_model">cm.proveedor.plaza</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="cm_proveedor_plaza_view_list"/>
        </record>
    </data>
</odoo>