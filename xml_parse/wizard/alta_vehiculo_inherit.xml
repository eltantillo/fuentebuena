<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="alta_vehiculo_inherit_form" model="ir.ui.view">
            <field name="name">alta.vehiculo.inherit.view.form</field>
            <field name="model">alta.vehiculo</field>
            <field name="inherit_id" ref="fleet_compra.fleet_orden_compra_alta_vehiculo_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='data_vehiculo']" position="before">
                    <group string="Documentos fiscales">
                        <field name="document_xml" string="Factura XML" required="1"/>
                    </group>
                </xpath>
                <xpath expr="//field[@name='vin_sn']" position="before">
                    <field name="num_puertas"/>
                </xpath>
                <xpath expr="//group[@name='data_vehiculo']" position="after">
                    <group string="Datos fiscales">
                        <group>
                            <field name="fecha" string="Fecha de adquisición" required="1"/>
                        </group>
                        <group>
                            <field name="importe_adquisicion" string="Importe de adquisición" required="1"/>
                            <field name="iva_adquisicion" string="IVA de adquisición" required="1"/>
                            <field name="total" string="Total" required="1"/>
                        </group>
                    </group>
                    <group string="Factura">
                        <field name="factura" required="1"/>
                        <field name="folio_uuid" required="1"/>
                        <field name="pdf_factura" widget="pdf_viewer" required="1"/>
                    </group>
                </xpath>
            </field>
        </record>
    </data>
</odoo>