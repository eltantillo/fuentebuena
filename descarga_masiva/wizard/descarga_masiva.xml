<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="descarga_masiva_view_form" model="ir.ui.view">
            <field name="name">descarga.masiva.view.form</field>
            <field name="model">descarga.masiva</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="vehiculo_ids" widget="many2many_tags"/>
                            <field name="modelo"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_descarga" string="Confirmar" type="object" class="btn btn-success"/>
                        <button string="Cancelar" special="cancel"  class="btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>

    </data>
</odoo>