<?xml version="1.0" encoding="UTF-8"?>
<templates>

     <!-- === Hide New Button ===  -->
     <!-- List View  -->
    <t t-name="web.ListView" t-inherit="web.ListView" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_list_button_add')]" position="replace">
            <t t-if="state.group_show_create">
                <button type="button" class="btn btn-primary o_list_button_add" data-hotkey="c"
                    t-on-click="onClickCreate" data-bounce-button="">
                    New
                </button>
            </t>
        </xpath>
    </t>

    <!-- Form View  -->
    <t t-name="web.FormView" t-inherit="web.FormView" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o_form_button_create')]" position="replace">
            <t t-if="state.group_show_create">
                <button type="button" class="btn btn-outline-primary o_form_button_create"
                    data-hotkey="c" t-on-click.stop="create" t-att-disabled="state.isDisabled">New</button>
            </t>
        </xpath>
        <!-- <xpath expr="//t[6]/t/button" position="replace">
            <t t-if="state.group_show_create">
                <button type="button" class="btn btn-outline-primary o_form_button_create"
                    data-hotkey="c" t-on-click.stop="create">New</button>
            </t>
        </xpath> -->
        <xpath expr="//t[@t-set-slot='control-panel-create-button']" position="replace">
            <t t-set-slot="control-panel-create-button">
                <t t-if="state.group_show_create">
                    <button type="button" class="btn btn-outline-primary o_form_button_create"
                            data-hotkey="c"
                            t-on-click.stop="create"
                            t-att-disabled="state.isDisabled">
                        New
                    </button>
                </t>
            </t>
        </xpath>
    </t>

    <!-- Kanban View  -->
    <t t-name="web.KanbanView" t-inherit="web.KanbanView" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('o-kanban-button-new')]" position="replace">
            <t t-if="state.group_show_create">
                <button type="button" class="btn btn-primary o-kanban-button-new" accesskey="c"
                    t-on-click="() => this.createRecord()" data-bounce-button="">
                    New
                </button>
            </t>
        </xpath>
    </t>

    <!-- Hide ExportAll Button That Inside MultiAction In List View  -->
    <t t-name="web.ExportAll" t-inherit="web.ExportAll" t-inherit-mode="extension">
        <xpath expr="//DropdownItem" position="replace">
            <t t-if="state.group_show_export">
                <DropdownItem class="'o_export_all_menu'" onSelected.bind="onDirectExportData">
                    <i class="fa fa-fw fa-upload me-1"/>Export All
                </DropdownItem>
            </t>
        </xpath>
    </t>
</templates>
