<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_customer_portfolio" model="ir.module.category">
        <field name="name">Customer Portfolio</field>
        <field name="description">Access to the customer portfolio board and the 360 client sheet</field>
    </record>

    <!-- Odoo 19 groups the user-form selector by res.groups.privilege; res.groups
         lost category_id, so the category hangs off the privilege instead. -->
    <record id="res_groups_privilege_customer_portfolio" model="res.groups.privilege">
        <field name="name">Customer Portfolio</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="module_category_customer_portfolio"/>
    </record>

    <record id="group_customer_portfolio_user" model="res.groups">
        <field name="name">Portfolio Reader</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_customer_portfolio"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

</odoo>
