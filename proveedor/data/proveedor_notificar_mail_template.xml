<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="proveedor_notificar_mail_template"  model="mail.template">
            <field name="name">Correo de notifiación</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="subject">El proveedor enviado para confirmación</field>
            <field name="body_html">
                <![CDATA[
                    <div style="box-sizing:border-box;font-size:13px;background-color: #FCFCFC; border-radius: 10px; padding: 20px; position: relative;">
                          <img src="https://www.aprecia.com.mx/firmas/Pilotea.png" alt="Logo" style="border-style:none;box-sizing:border-box;vertical-align:middle;position: absolute; top: 10px; right: 10px; height: 50px;" width="140.828" height="50">
                          <h2 style="margin:0px 0 6px 0;box-sizing:border-box;font-size:19.5px;color:#091124;line-height:1.2;text-align: center; font-weight: bold;">Proveedor enviado a confirmación</h2>
                          <br>
                          <span style="font-weight: bolder;">El proveedor  con RFC:</span> <t t-out="object.vat" data-oe-t-inline="true" contenteditable="false"></t><br>
                          <span style="font-weight: bolder;">Ha sido mandado a revisión para su posible validación</span>
                          <br><br>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>