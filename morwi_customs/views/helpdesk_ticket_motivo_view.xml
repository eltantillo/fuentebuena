<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="helpdesk_ticket_motivo_view_list" model="ir.ui.view">
        <field name="name">helpdesk.ticket.motivo.list</field>
        <field name="model">helpdesk.ticket.motivo</field>
        <field name="arch" type="xml">
            <list string="Motivos de ticket" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="tipo_ticket"/>
                <field name="name"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_ticket_motivo_view_form" model="ir.ui.view">
        <field name="name">helpdesk.ticket.motivo.form</field>
        <field name="model">helpdesk.ticket.motivo</field>
        <field name="arch" type="xml">
            <form string="Motivo de ticket">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="tipo_ticket"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_ticket_motivo_action" model="ir.actions.act_window">
        <field name="name">Motivos de ticket</field>
        <field name="res_model">helpdesk.ticket.motivo</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="helpdesk_ticket_motivo_menu"
              name="Motivos de ticket"
              parent="helpdesk.helpdesk_menu_config"
              action="helpdesk_ticket_motivo_action"
              sequence="30"/>
</odoo>
