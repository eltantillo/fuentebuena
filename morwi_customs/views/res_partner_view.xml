<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="res_partner_form_view_customs" model="ir.ui.view">
            <field name="name">res.partner.form.view.customs</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='vat']" position="attributes">
                    <attribute name="groups">morwi_customs.collections_team_contact_groups</attribute>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_fleet_vehicles" type="object" class="oe_stat_button" icon="fa-truck">
                        <field name="fleet_vehicle_count" widget="statinfo" string="Vehicles"/>
                    </button>
                    <button name="action_view_fleet_vehicle_log_contracts" type="object" class="oe_stat_button" icon="fa-file-text-o">
                        <field name="fleet_vehicle_log_contract_count" widget="statinfo" string="Contracts"/>
                    </button>
                    <button name="action_view_fleet_polizas" type="object" class="oe_stat_button" icon="fa-shield">
                        <field name="fleet_poliza_count" widget="statinfo" string="Policies"/>
                    </button>
                    <button name="action_view_fleet_siniestros" type="object" class="oe_stat_button" icon="fa-exclamation-triangle">
                        <field name="fleet_siniestro_count" widget="statinfo" string="Claims"/>
                    </button>
                    <button name="action_view_fleet_tramites" type="object" class="oe_stat_button" icon="fa-id-card-o">
                        <field name="fleet_tramite_count" widget="statinfo" string="Procedures"/>
                    </button>
                </xpath>
                <xpath expr="//sheet/group/group[last()]" position="after">
                    <group name="group_1" string="Vehicle information">
                        <field name="fleet_customer_plaza_id"/>
                        <field name="fleet_vehicle_salesman"/>
                        <field name="fleet_customer_producto_id"/>
                    </group>
                </xpath>
                <!-- NUEVAS PESTAÑAS -->
                <xpath expr="//sheet/notebook/page[@name='sales_purchases']" position="after">
                    <page name="expediente_unidad" string="Póliza y documentos de la unidad" invisible="not fleet_vehicle_ids">
                        <separator string="Vehículos"/>
                        <field name="fleet_vehicle_ids">
                            <list create="0" edit="0" delete="0">
                                <field name="vin_sn"/>
                                <field name="license_plate"/>
                                <field name="numero_economico"/>
                                <field name="estado_factura" widget="badge"
                                       decoration-success="estado_factura == 'completo'"
                                       decoration-warning="estado_factura == 'falta_subir'"
                                       string="Factura de la unidad"/>
                            </list>
                        </field>
                        <separator string="Pólizas de seguro"/>
                        <field name="fleet_poliza_ids">
                            <list create="0" edit="0" delete="0">
                                <field name="tipo_poliza_id"/>
                                <field name="num_poliza"/>
                                <field name="vin_sn"/>
                                <field name="fecha_vencimiento"/>
                                <field name="estado_vigencia" widget="badge"
                                       decoration-success="estado_vigencia == 'vigente'"
                                       decoration-danger="estado_vigencia == 'vencido'"
                                       decoration-warning="estado_vigencia == 'falta_subir'"/>
                            </list>
                        </field>
                        <separator string="Trámites (tarjeta de circulación, verificación, tenencia, etc.)"/>
                        <field name="fleet_tramite_ids">
                            <list create="0" edit="0" delete="0">
                                <field name="tipo_tramite_id"/>
                                <field name="folio"/>
                                <field name="vin_sn"/>
                                <field name="fecha_vencimiento_renovacion"/>
                                <field name="estado_vigencia" widget="badge"
                                       decoration-success="estado_vigencia == 'vigente'"
                                       decoration-danger="estado_vigencia == 'vencido'"
                                       decoration-warning="estado_vigencia == 'falta_subir'"/>
                            </list>
                        </field>
                        <separator string="Contratos firmados"/>
                        <field name="fleet_vehicle_log_contract_ids">
                            <list create="0" edit="0" delete="0">
                                <field name="vin_sn"/>
                                <field name="state"/>
                                <field name="expiration_date"/>
                                <field name="estado_vigencia" widget="badge"
                                       decoration-success="estado_vigencia == 'vigente'"
                                       decoration-danger="estado_vigencia == 'vencido'"
                                       decoration-warning="estado_vigencia == 'falta_subir'"/>
                            </list>
                        </field>
                    </page>
                    <page name="insurance_and_claims" string="Insurance and Claims">
                        <group>
                            <group>
                                <field name="fleet_siniestro_estatus_id"/>
                            </group>
                        </group>
                    </page>
                    <page name="invoice" string="Invoice">
                        <group>
                            <group>

                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>