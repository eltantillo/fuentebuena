<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The `show_*` visibility gates were moved from helpdesk.team to
         helpdesk.ticket.motivo. The old view is dropped here so it does not
         break the validation of the helpdesk.team form on upgrade: orphan
         records are only vacuumed at the end of the module load. Matched by
         name rather than by XML ID so the load stays silent on databases
         where the view is already gone. -->
    <delete model="ir.ui.view" search="[('model', '=', 'helpdesk.team'), ('name', '=', 'helpdesk.team.form.inherit.custom.fields')]"/>

    <record id="helpdesk_team_view_form_inherit_team_leader" model="ir.ui.view">
        <field name="name">helpdesk.team.form.inherit.team.leader</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='member_ids']" position="before">
                <div class="mt16 d-flex" name="user_id">
                    <label for="user_id"/>
                    <field name="user_id" widget="many2one_avatar_user" class="ms-3"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
