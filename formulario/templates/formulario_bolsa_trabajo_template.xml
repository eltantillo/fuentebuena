<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="template_formulario_bolsa_trabajo" name="Formulario bolsa de trabajo">
        <t t-set="page_name" t-value="'formulario_bolsa_trabajo'"/>
        <t t-call-assets="formulario.assets_frontend" t-css="true" t-js="true"/>
        <script src="/formulario/static/src/js/bootstrap.bundle.min.js" type="text/javascript"/>
        <script src="/formulario/static/src/js/validacion.js" type="text/javascript" />
        <script src="/formulario/static/src/js/bolsa_trabajo_area.js" type="text/javascript" />
        <div class="container">
          <div class="row justify-content-center">
            <div class="col-md-5">
                <form action="/bolsa-trabajo/submit" method="POST" class="row g-3 needs-validation formulario-transparente" id="formulario" novalidate="novalidate" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="row mb-2">
                        <div class="col-4">
                            <label>Nombre</label>
                        </div>
                        <div class="col-8">
                            <input type="text" name="name" class="form-control rounded-2" required="required"/>
                            <div class="invalid-feedback text-center rounded-3" style="color: red;">
                              Rellena este campo, es obligatorio.
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4">
                            <label>No. Teléfono</label>
                        </div>
                        <div class="col-8">
                            <input type="text" name="telefono" placeholder="Teléfono"
                                    class="form-control no-spinners rounded-2" required="required"
                                    pattern="[0-9]{10}" title="Debe contener exactamente 10 dígitos"
                                    maxlength="10"
                                    inputmode="numeric"
                                    oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                            <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                              Rellena este campo,es obligatorio.
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4">
                            <label>Correo</label>
                        </div>
                        <div class="col-8">
                            <input type="email" name="correo" class="form-control rounded-2" required="required"/>
                            <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                              Rellena este campo, es obligatorio.
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4">
                            <label>Área de aplicación</label>
                        </div>
                        <div class="col-8">
                            <select name="area_id" class="form-select rounded-2" required="required">
                                <option value="">Seleccione una opción</option>
                                <t t-foreach="areas" t-as="area">
                                    <option t-att-value="area.id">
                                        <t t-esc="area.name"/>
                                    </option>
                                </t>
                            </select>
                            <div class="invalid-feedback text-center rounded-3" style="color: red;">
                              Por favor, seleccione una opción.
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4">
                            <label>Asunto</label>
                        </div>
                        <div class="col-8">
                            <input type="text" name="asunto" class="form-control rounded-2" required="required"/>
                            <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                              Rellena este campo, es obligatorio.
                            </div>
                        </div>
                    </div>
                    <div class="row mb-2">
                        <div class="col-4">
                            <label>CV</label>
                        </div>
                        <div class="col-8">
                             <input type="file" name="cv" class="form-control rounded-2" required="required" accept=".pdf,application/pdf"/>
                            <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                              Adjunta un archivo.
                            </div>
                        </div>
                    </div>
                    <div>
                         <button type="submit" id="btn_submit" class="btn btn-primary btn-custom mb-1" style="width: 30%"><span style="color: white; font-weight: bold;">Enviar</span></button>
                    </div>
                </form>
            </div>
          </div>
        </div>
    </template>
</odoo>