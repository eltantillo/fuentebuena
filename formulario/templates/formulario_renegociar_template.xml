<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="template_formulario_renegociar" name="Formulario Renegociar">
        <t t-set="page_name" t-value="'formulario_renegociar'"/>
        <t t-call-assets="formulario.assets_frontend" t-css="true" t-js="true"/>
        <script src="/formulario/static/src/js/bootstrap.bundle.min.js" type="text/javascript"/>
        <script src="/formulario/static/src/js/validacion.js" type="text/javascript" />
        <div class="container" style="background-color: #3d1d60 !important;">
            <div class="text-center">
                <br/>
                <p style="color: white; font-size: 1rem">Rellena el formulario y uno de nuestros asesores te contactará para iniciar el trámite de tu crédito</p>
            </div>
          <div class="row justify-content-center mt-1">
            <div class="col-md-3">
                <form action="/renegociar-deuda/submit" method="POST" class="row g-3 needs-validation formulario-transparente" id="formulario" novalidate="novalidate" >
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-0">
                        <input type="text" name="name" placeholder="Nombre" class="form-control" required="required"/>
                        <div class="invalid-feedback text-center rounded-3" style="background-color: #C71585; color: white;">
                          Rellena este campo, es obligatorio.
                        </div>
                    </div>
                    <div class="mb-0">
                        <input type="text" name="apellido" placeholder="Apellido" class="form-control" required="required"/>
                        <div class="invalid-feedback text-center rounded-3" style="background-color: #C71585; color: white;">
                          Rellena este campo, es obligatorio.
                        </div>
                    </div>
                    <div class="mb-0">
                        <input type="email" name="correo" placeholder="Correo" class="form-control" required="required"/>
                        <div class="invalid-feedback text-center rounded-3" style="background-color: #C71585; color: white;">
                          Rellena este campo, es obligatorio.
                        </div>
                    </div>
                    <div class="mb-0">
                        <input type="text" name="telefono" placeholder="Teléfono"
                                    class="form-control no-spinners" required="required"
                                    pattern="[0-9]{10}" title="Debe contener exactamente 10 dígitos"
                                    maxlength="10"
                                    inputmode="numeric"
                                    oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                        <div class="invalid-feedback text-center rounded-3" style="background-color: #C71585; color: white;">
                          Rellena este campo,es obligatorio.
                        </div>
                    </div>
                    <div class="mb-0">
                        <select name="estado" class="form-select" required="required">
                            <option value="">Estado</option>
                            <t t-foreach="estados" t-as="estado">
                                <option t-att-value="estado[0]"><t t-esc="estado[1]"/></option>
                            </t>
                        </select>
                        <div class="invalid-feedback text-center rounded-3" style="background-color: #C71585; color: white;">
                          Por favor, seleccione una opción.
                        </div>
                    </div>
                    <div class="mb-0">
                        <select name="puesto_id" class="form-select" required="required">
                            <option value="">¿En qué puesto se desempeña?</option>
                            <t t-foreach="puesto_ocupado" t-as="puesto">
                                <option t-att-value="puesto.id">
                                    <t t-esc="puesto.name"/>
                                </option>
                            </t>
                        </select>
                        <div class="invalid-feedback text-center rounded-3" style="background-color: #C71585; color: white;">
                          Por favor, seleccione una opción.
                        </div>
                    </div>
                    <div class="mb-0">
                        <select name="medio_contacto_id" class="form-select" required="required">
                            <option value="">¿Cómo quiere que lo contactemos?</option>
                            <t t-foreach="medios_contacto" t-as="medio">
                                <option t-att-value="medio.id">
                                    <t t-esc="medio.name"/>
                                </option>
                            </t>
                        </select>
                        <div class="invalid-feedback text-center rounded-3" style="background-color: #C71585; color: white;">
                          Por favor, seleccione una opción.
                        </div>
                    </div>
                    <button type="submit" id="btn_submit" class="btn btn-primary mb-1" >Contactar con un asesor</button>
                </form>
            </div>
          </div>
        </div>
    </template>
</odoo>
