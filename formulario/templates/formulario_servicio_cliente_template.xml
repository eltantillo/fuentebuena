<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="template_formulario_servicio_cliente" name="Formulario servico al cliente">
        <t t-set="page_name" t-value="'formulario_servicio_cliente'"/>
        <t t-call-assets="formulario.assets_frontend" t-css="true" t-js="true"/>
        <script src="/formulario/static/src/js/bootstrap.bundle.min.js" type="text/javascript"/>
        <script src="/formulario/static/src/js/validacion.js" type="text/javascript" />
        <div class="container mt-2">
          <div class="row justify-content-center">
            <div class="col-md-5">
                <form action="/servicio-al-cliente/submit" method="POST" id="formulario" class="row g-3 needs-validation formulario-transparente" novalidate="novalidate" enctype="multipart/form-data">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="mb-1">
                        <label>Nombre</label><br/>
                        <input type="text" name="name" class="form-control rounded-1" required="required"/>
                        <div class="invalid-feedback text-center rounded-3" style="color: red;">
                          Rellena este campo, es obligatorio.
                        </div>
                    </div>
                    <div class="mb-1">
                        <label>Apellido</label><br/>
                        <input type="text" name="apellido" class="form-control rounded-1" required="required"/>
                        <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                          Rellena este campo, es obligatorio.
                        </div>
                    </div>
                    <div class="mb-1">
                        <label>Correo</label><br/>
                        <input type="email" name="correo" class="form-control rounded-1" required="required"/>
                        <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                          Rellena este campo, es obligatorio.
                        </div>
                    </div>
                    <div class="mb-1">
                        <label>Número de télefono</label><br/>
                        <input type="text" name="telefono" placeholder="Teléfono"
                                    class="form-control no-spinners" required="required"
                                    pattern="[0-9]{10}" title="Debe contener exactamente 10 dígitos"
                                    maxlength="10"
                                    inputmode="numeric"
                                    oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                        <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                          Rellena este campo,es obligatorio.
                        </div>
                    </div>
                    <div class="mb-1">
                        <label>Mensaje</label><br/>
                        <textarea  name="mensaje" class="form-control rounded-1" rows="3" required="required" />
                        <div class="invalid-feedback text-center rounded-3"  style="color: red;">
                           Rellena este campo,es obligatorio.
                        </div>
                    </div>
                    <div class="mb-1">
                         <button type="submit" id="btn_submit" class="btn mb-1" style="background-color:#204d74;width: 30%"><span style="color: white; font-weight: bold;">Enviar</span></button>
                    </div>
                </form>
            </div>
          </div>
        </div>
    </template>
</odoo>