<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="template_formulario_prospecto_colaborador" name="Formulario Prospecto Colaborador">

        <t t-call="website.layout">

            <t t-set="title">Prospecto colaborador</t>
            <t t-set="page_name" t-value="'formulario_prospecto_colaborador'"/>

            <script src="/formulario/static/src/js/validacion.js" type="text/javascript"/>
            <link rel="stylesheet" href="/formulario/static/lib/select2/select2.min.css"/>
            <link rel="stylesheet" href="/formulario/static/src/css/style_form.css"/>
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"/>
            <script src="/formulario/static/lib/select2/select2.min.js"/>
            <script src="/formulario/static/src/js/select2.js"/>

            <div style="font-family: Arial, sans-serif; text-align: center; padding: 20px;">
                <br/>

                <div id="card-formulario-animador">

                    <h1>
                        <i class="bi bi-people-fill me-2"/>
                        Prospectos de herramientas de Marketing.
                    </h1>

                    <br/>

                    <div class="container mt-4">
                        <div class="row justify-content-center">
                            <div class="col-md-10">

                                <form action="/prospeccion/submit" method="POST"
                                      class="row g-3 needs-validation"
                                      id="formulario-animador"
                                      novalidate="novalidate">

                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Nombre</label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" name="nombre" class="form-control rounded-2" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">Campo obligatorio</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Apellido</label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" name="apellido" class="form-control rounded-2" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">Campo obligatorio</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>RFC</label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" name="rfc" class="form-control rounded-2" maxlength="13" style="text-transform:uppercase;" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">Ingresa un RFC válido</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Celular</label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" name="celular" class="form-control rounded-2" pattern="[0-9]{10}" maxlength="10" inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '');" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">Debe tener 10 dígitos</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Confirmar Celular</label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" name="confirmacion_celular" class="form-control rounded-2" pattern="[0-9]{10}" maxlength="10" inputmode="numeric" oninput="this.value = this.value.replace(/[^0-9]/g, '');" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">Confirma el número correctamente</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Gerente o vendedor</label>
                                        </div>
                                        <div class="col-9">
                                            <input type="text" name="nombre_gerente_vendedor" class="form-control rounded-2" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">Campo obligatorio</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Puesto</label>
                                        </div>
                                        <div class="col-9">
                                            <select name="puesto_id" class="form-select rounded-2" required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="puestos" t-as="puesto">
                                                    <option t-att-value="puesto.id"><t t-esc="puesto.name"/></option>
                                                </t>
                                            </select>
                                            <div class="invalid-feedback text-center" style="color:red;">Selecciona un puesto</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Convenio</label>
                                        </div>
                                        <div class="col-9">
                                            <select name="convenio_id" class="form-select rounded-2" required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="convenios" t-as="conv">
                                                    <option t-att-value="conv.id"><t t-esc="conv.name"/></option>
                                                </t>
                                            </select>
                                            <div class="invalid-feedback text-center" style="color:red;">Selecciona un convenio</div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-3 text-start">
                                            <label>Actividad</label>
                                        </div>
                                        <div class="col-9">
                                            <select name="actividad_id" class="form-select rounded-2" required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="actividades" t-as="act">
                                                    <option t-att-value="act.id"><t t-esc="act.name"/></option>
                                                </t>
                                            </select>
                                            <div class="invalid-feedback text-center" style="color:red;">Selecciona una actividad</div>
                                        </div>
                                    </div>

                                    <div class="text-center">
                                        <button type="submit" class="btn btn-animador">
                                            Enviar
                                        </button>
                                    </div>

                                </form>
                            </div>
                        </div>
                    </div>
                    <br/>
                </div>
            </div>
        </t>
    </template>
</odoo>