<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <template id="template_formulario_prestamo_sin_buro" name="Formulario prestamo sin buro">
        <t t-call="website.layout">
            <t t-set="title">Préstamo Sin Buró - Aprecia tu Nómina</t>
            <t t-set="page_name" t-value="'formulario_prestamo_sin_buro'"/>
            <script src="/formulario/static/src/js/validacion.js" type="text/javascript" />
            <script src="/formulario/static/src/js/convenio.js" type="text/javascript" />
            <link rel="stylesheet" href="/formulario/static/src/css/style_form.css"/>
            <script src="https://code.jquery.com/jquery-3.6.0.min.js"/>
            <div style="font-family: Arial, sans-serif; text-align: center; padding: 20px;">
                <br/>
                <section class="oe_structure"></section>
                <div id="card-formulario-animador">
                    <h1>Solicita tu préstamo sin buró</h1>
                    <br/>
                    <div class="container mt-4">
                        <div class="row justify-content-center">
                            <div class="col-md-8">
                                <form action="/solicita-tu-credito/submit" method="POST" id="formulario-animador" class="needs-validation"  novalidate="novalidate">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <div id="convenios-data" style="display:none;"
                                         t-att-data-convenios="json.dumps([{
                                             'id': convenio.id,
                                             'name': convenio.name or '',
                                             'estado': convenio.estado_id.id or 0
                                         } for convenio in convenios])">
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>¿Eres trabajador del ayuntamiento?</label>
                                        </div>
                                        <div class="col-8">
                                            <select name="respuesta" id="respuesta" class="form-select rounded-2" required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="respuesta" t-as="res">
                                                    <option t-att-value="res[0]"><t t-esc="res[1]"/></option>
                                                </t>
                                            </select>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Por favor, seleccione una opción.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>Nombre</label>
                                        </div>
                                        <div class="col-8">
                                            <input type="text" name="name" placeholder="Nombre" class="form-control rounded-2" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Rellena este campo, es obligatorio.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>Apellido</label>
                                        </div>
                                        <div class="col-8">
                                            <input type="text" name="apellido" placeholder="Apellido" class="form-control rounded-2" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Rellena este campo, es obligatorio.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>Correo electrónico</label>
                                        </div>
                                        <div class="col-8">
                                            <input type="email" name="correo" placeholder="Correo" class="form-control rounded-2" required="required"/>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Ingresa un correo válido
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>Número de teléfono</label>
                                        </div>
                                        <div class="col-8">
                                            <input type="text" name="telefono" placeholder="Teléfono"
                                                   class="form-control rounded-2 no-spinners" required="required"
                                                   pattern="[0-9]{10}" title="Debe contener exactamente 10 dígitos"
                                                   maxlength="10"
                                                   inputmode="numeric"
                                                   oninput="this.value = this.value.replace(/[^0-9]/g, '');" />
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Debe tener 10 dígitos
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>Estado</label>
                                        </div>
                                        <div class="col-8">
                                            <select name="estado" id="estado" class="form-select rounded-2" required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="estados" t-as="estado">
                                                    <option t-att-value="estado.id"><t t-esc="estado.name"/></option>
                                                </t>
                                            </select>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Por favor, seleccione una opción.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2 no-mostrar" id="convenio">
                                        <div class="col-4 text-start">
                                            <label>Convenio</label>
                                        </div>

                                        <div class="col-8">
                                            <select name="convenio_id" id="convenio_select" class="form-select rounded-2">
                                                <option value="">Seleccione una opción</option>
                                            </select>

                                            <div class="invalid-feedback text-center" style="color:red;" id="validacion">
                                                Por favor, seleccione una opción.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>Puesto que desempeña</label>
                                        </div>
                                        <div class="col-8">
                                            <select name="puesto_id" class="form-select rounded-2" required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="puesto_ocupado" t-as="puesto">
                                                    <option t-att-value="puesto.id">
                                                        <t t-esc="puesto.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Por favor, seleccione una opción.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="row mb-2">
                                        <div class="col-4 text-start">
                                            <label>Producto</label>
                                        </div>
                                        <div class="col-8">
                                            <select name="producto_id" class="form-select rounded-2" required="required">
                                                <option value="">Seleccione una opción</option>
                                                <t t-foreach="productos" t-as="prod">
                                                    <option t-att-value="prod.id">
                                                        <t t-esc="prod.name"/>
                                                    </option>
                                                </t>
                                            </select>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Por favor, seleccione una opción.
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row mb-2">
                                        <div class="col-12 text-center">
                                            <input type="checkbox" id="terminos" name="terminos_condiciones" required="required"/>
                                            <label>
                                                Acepto
                                                <a href="#" data-bs-toggle="modal" data-bs-target="#modalTerminosAnimador">
                                                    el uso de mis datos personales
                                                </a>
                                            </label>
                                            <div class="invalid-feedback text-center" style="color:red;">
                                                Debes aceptar el uso de datos personales.
                                            </div>
                                        </div>
                                    </div>
                                    <div class="text-center">
                                        <button type="submit" class="btn btn-animador">
                                            Contactar con un asesor
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                    <br/>
                </div>
                <section class="oe_structure"></section>
            </div>
        </t>

        <div class="modal fade" id="modalTerminosAnimador" tabindex="-1" aria-labelledby="modalTerminosAnimadorLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="modalTerminosAnimadorLabel">
                            Uso de datos personales.
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>
                            Al enviar este formulario, autorizo el tratamiento de mis datos personales para ser contactado(a), recibir asesoría y enviarme información y promociones relacionadas con productos de crédito.
                        </p>
                        <p>
                            Reconozco que puedo solicitar la cancelación o revocación de mi consentimiento en cualquier momento, conforme a la legislación aplicable.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-modal-animador"
                                onclick="document.getElementById('terminos').checked = true"
                                data-bs-dismiss="modal">
                            Aceptar
                        </button>
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </template>
</odoo>