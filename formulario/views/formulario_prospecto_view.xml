<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="formulario_prospecto_view_form" model="ir.ui.view">
            <field name="name">formulario.prospecto.view.form</field>
            <field name="model">formulario.prospecto</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Datos del usuario">
                            <field name="create_date" string="Fecha de creación"/>
                            <field name="nombre"/>
                            <field name="apellido"/>
                            <field name="rfc"/>
                            <field name="celular" string="Télefono"/>
                            <field name="confirmacion_celular" string="Confirmación télefono"/>
                            <field name="convenio_id"/>
                            <field name="celula_id" string="Célula"/>
                            <field name="terminos_condiciones"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="formulario_prospecto_view_list" model="ir.ui.view">
            <field name="name">formulario.prospecto.view.list</field>
            <field name="model">formulario.prospecto</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="create_date" string="Fecha de creación"/>
                    <field name="nombre"/>
                    <field name="apellido"/>
                    <field name="rfc"/>
                    <field name="celular" string="Télefono"/>
                    <field name="convenio_id"/>
                    <field name="celula_id" string="Célula"/>
                    <field name="terminos_condiciones"/>
                </list>
            </field>
        </record>

        <record id="formulario_prospecto_action" model="ir.actions.act_window">
            <field name="name">Prospectos</field>
            <field name="res_model">formulario.prospecto</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="formulario_prospecto_view_list"/>
        </record>
    </data>
</odoo>