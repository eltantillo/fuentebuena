<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="formulario_ayuntamiento_view_form" model="ir.ui.view">
            <field name="name">formulario.ayuntamiento.view.form</field>
            <field name="model">formulario.ayuntamiento</field>
            <field name="arch" type="xml">
                <form string="Formulario convenio">
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="estado_id"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="formulario_ayuntamiento_view_list" model="ir.ui.view">
            <field name="name">formulario.ayuntamiento.view.list</field>
            <field name="model">formulario.ayuntamiento</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="estado_id"/>
                </list>
            </field>
        </record>

        <record id="formulario_ayuntamiento_action" model="ir.actions.act_window">
            <field name="name">Ayuntamientos</field>
            <field name="res_model">formulario.ayuntamiento</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="formulario_ayuntamiento_view_list"/>
        </record>
    </data>
</odoo>