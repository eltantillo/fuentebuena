<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="formulario_puesto_ocupado_view_form" model="ir.ui.view">
            <field  name="name">formulario.medio.contacto.view.form</field>
            <field name="model">puesto.ocupado</field>
            <field name="arch" type="xml">
                <form string="Formulario medio de contacto">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="formulario_puesto_ocupado_view_list" model="ir.ui.view">
            <field name="name">formulario.medio.contacto.view.list</field>
            <field name="model">puesto.ocupado</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="formulario_puesto_ocupado_action" model="ir.actions.act_window">
            <field name="name"> Puesto que desempeña</field>
            <field name="res_model">puesto.ocupado</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="formulario_puesto_ocupado_view_list"/>
        </record>

    </data>
</odoo>