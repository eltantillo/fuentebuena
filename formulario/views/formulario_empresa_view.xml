<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="formulario_empresa_view_form" model="ir.ui.view">
            <field name="name">formulario.empresa.view.form</field>
            <field name="model">formulario.empresa</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Datos del usuario">
                            <field name="create_date" string="Fecha de creación"/>
                            <field name="nombre_completo"/>
                            <field name="numero_telefono"/>
                            <field name="correo"/>
                            <field name="empresa_id"/>
                            <field name="rfc"/>
                            <field name="autorizacion_datos"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="formulario_empresa_view_list" model="ir.ui.view">
            <field name="name">formulario.empresa.view.list</field>
            <field name="model">formulario.empresa</field>
            <field name="arch" type="xml">
                <list>
                    <field name="create_date" string="Fecha de creación"/>
                    <field name="nombre_completo"/>
                    <field name="numero_telefono"/>
                    <field name="correo"/>
                    <field name="empresa_id"/>
                    <field name="rfc"/>
                    <field name="autorizacion_datos"/>
                </list>
            </field>
        </record>

        <record id="formulario_empresa_action" model="ir.actions.act_window">
            <field name="name">Formulario empresa</field>
            <field name="res_model">formulario.empresa</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="formulario_empresa_view_list"/>
        </record>
    </data>
</odoo>