<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="formulario_servicio_cliente_view_form" model="ir.ui.view">
            <field name="name">formulario.servicio.cliente.view.form</field>
            <field name="model">formulario.servicio.cliente</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Datos del usuario">
                            <field name="create_date" string="Fecha de creación"/>
                            <field name="nombre"/>
                            <field name="apellido"/>
                            <field name="correo"/>
                            <field name="telefono"/>
                            <field name="mensaje"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="formulario_servicio_cliente_view_list" model="ir.ui.view">
            <field name="name">formulario.servicio.cliente.view.list</field>
            <field name="model">formulario.servicio.cliente</field>
            <field name="arch" type="xml">
                <list>
                    <field name="create_date" string="Fecha de creación"/>
                    <field name="nombre"/>
                    <field name="apellido"/>
                    <field name="correo"/>
                    <field name="telefono"/>
                    <field name="mensaje"/>
                </list>
            </field>
        </record>

        <record id="formulario_servicio_cliente_action" model="ir.actions.act_window">
            <field name="name">Formulario servicio al cliente</field>
            <field name="res_model">formulario.servicio.cliente</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="formulario_servicio_cliente_view_list"/>
        </record>
    </data>
</odoo>