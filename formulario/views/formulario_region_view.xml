<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="formulario_region_view_form" model="ir.ui.view">
            <field name="name">formulario.region.view.form</field>
            <field name="model">formulario.region</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="formulario_region_view_list" model="ir.ui.view">
            <field name="name">formulario.region.view.form</field>
            <field name="model">formulario.region</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="formulario_region_action" model="ir.actions.act_window">
            <field name="name">Región</field>
            <field name="res_model">formulario.region</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="formulario_region_view_list"/>
        </record>
    </data>
</odoo>