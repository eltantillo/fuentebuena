<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="formulario_empresa_config_view_form" model="ir.ui.view">
            <field name="name">formulario.empresa.config.view.form</field>
            <field name="model">formulario.empresa.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="active" invisible="1" readonly="1"/>
                                <field name="name"/>
                                <field name="slug"/>
                            </group>
                            <group>
                                <field name="logo" widget="image"/>
                                <field name="color_primario"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="formulario_empresa_config_view_list" model="ir.ui.view">
            <field name="name">formulario.empresa.config.view.list</field>
            <field name="model">formulario.empresa.config</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="slug"/>
                </list>
            </field>
        </record>

        <record id="formulario_empresa_config_action" model="ir.actions.act_window">
            <field name="name">Formulario empresa / config</field>
            <field name="res_model">formulario.empresa.config</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="formulario_empresa_config_view_list"/>
        </record>
    </data>
</odoo>