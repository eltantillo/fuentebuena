<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="gasto_operativo_view_form" model="ir.ui.view">
            <field name="name">gasto.operativo.view.form</field>
            <field name="model">gasto.operativo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group string="Datos de gasto operativo" name="data_gasto_operativo">
                                <field name="motivo_id"/>
                                <field name="motivo_name" invisible="1"/>
                                <field name="concepto_id" domain="[('motivo_ids','in', motivo_id)]" invisible="motivo_name == 'Garantía'"/>
                                <field name="agente_id"/>
                                <field name="fecha"/>
                                <field name="metodo_pago_id"/>
                                <field name="es_facturable"/>
                                <field name="descripcion"/>
                                <field name="observaciones"/>
                            </group>
                            <group string="Importes" name="data_importe">
                                <field name="fecha_pago"/>
                                <field name="importe"/>
                                <field name="iva"/>
                                <field name="total"/>
                            </group>
                        </group>
                        <group string="Información del vehículo" name="data_vehiculo">
                            <field name="vehiculo_id" required="1"/>
                            <field name="vin_sn" readonly="1"/>
                            <field name="numero_economico" readonly="1"/>
                            <field name="producto_id" readonly="1"/>
                            <field name="plaza_id" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Expediente">
                                <field name="attach_gasto_operativo"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="gasto_operativo_view_list" model="ir.ui.view">
            <field name="name">gasto.operativo.view.list</field>
            <field name="model">gasto.operativo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="vehiculo_id"/>
                    <field name="motivo_id"/>
                    <field name="concepto_id"/>
                    <field name="fecha_pago"/>
                    <field name="total"/>
                </list>
            </field>
        </record>

        <record id="gasto_operativo_view_sarch" model="ir.ui.view">
            <field name="name">gasto.operativo.view.search</field>
            <field name="model">gasto.operativo</field>
            <field name="arch" type="xml">
                <search string="All vehicles">
                    <field string="VIN/sn" name="vin_sn" filter_domain="[('vin_sn', 'ilike', self)]"/>
                </search>
            </field>
        </record>

        <record id="gasto_operativo_action" model="ir.actions.act_window">
            <field name="name">Gasto Operativo</field>
            <field name="res_model">gasto.operativo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="gasto_operativo_view_list"/>
        </record>
    </data>
</odoo>