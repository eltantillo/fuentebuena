<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="gasto_operativo_metodo_pago_view_form" model="ir.ui.view">
            <field name="name">gasto.operativo.metodo.pago.view.form</field>
            <field name="model">gasto.operativo.metodo.pago</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="gasto_operativo_metodo_pago_view_list" model="ir.ui.view">
            <field name="name">gasto.operativo.metodo.pago.view.list</field>
            <field name="model">gasto.operativo.metodo.pago</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="gasto_operativo_metodo_pago_action" model="ir.actions.act_window">
            <field name="name">Gasto Operativo - Método de pago</field>
            <field name="res_model">gasto.operativo.metodo.pago</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="gasto_operativo_metodo_pago_view_list"/>
        </record>
    </data>
</odoo>