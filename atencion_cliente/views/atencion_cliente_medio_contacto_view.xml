<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="atencion_cliente_medio_contacto_view_form" model="ir.ui.view">
            <field name="name">atencion.cliente.medio.contacto.view.form</field>
            <field name="model">atencion.cliente.medio.contacto</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>


        <record id="atencion_cliente_medio_contacto_view_list" model="ir.ui.view">
            <field name="name">atencion.cliente.medio.contacto.view.list</field>
            <field name="model">atencion.cliente.medio.contacto</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="atencion_cliente_medio_contacto_action" model="ir.actions.act_window">
            <field name="name">Medio de contacto</field>
            <field name="res_model">atencion.cliente.medio.contacto</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="atencion_cliente_medio_contacto_view_list"/>
        </record>
    </data>
</odoo>