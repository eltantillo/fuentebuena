<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="atencion_cliente_interaccion_stage_view_form" model="ir.ui.view">
            <field name="name">atencion.cliente.interaccion.stage.view.form</field>
            <field name="model">atencion.cliente.interaccion.stage</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>


        <record id="atencion_cliente_interaccion_stage_view_list" model="ir.ui.view">
            <field name="name">atencion.cliente.interaccion.stage.view.list</field>
            <field name="model">atencion.cliente.interaccion.stage</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="atencion_cliente_interaccion_stage_action" model="ir.actions.act_window">
            <field name="name">Interaccion etapa</field>
            <field name="res_model">atencion.cliente.interaccion.stage</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="atencion_cliente_interaccion_stage_view_list"/>
        </record>
    </data>
</odoo>