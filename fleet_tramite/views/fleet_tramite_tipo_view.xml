<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_tramite_tipo_view_form" model="ir.ui.view">
            <field name="name">fleet.tramite.tipo.view.form</field>
            <field name="model">fleet.tramite.tipo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="active" invisible="1"/>
                            <field name="name"/>
                            <field name="notificar_renovacion"/>
                            <field name="dias_notificacion"/>
                        </group>
                        <notebook>
                            <page string="Usuarios a notificar">
                                <field name="usuarios_notificar_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fleet_tramite_tipo_view_list" model="ir.ui.view">
            <field name="name">fleet.tramite.tipo.view.list</field>
            <field name="model">fleet.tramite.tipo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="notificar_renovacion"/>
                    <field name="dias_notificacion"/>
                </list>
            </field>
        </record>

        <record id="fleet_tramite_tipo_action" model="ir.actions.act_window">
            <field name="name">Tipos de Trámites</field>
            <field name="res_model">fleet.tramite.tipo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="fleet_tramite_tipo_view_list"/>
        </record>
    </data>
</odoo>