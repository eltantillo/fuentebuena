<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_catalogo_orig_creacion_inherit_mantenimiento_view_form" model="ir.ui.view">
            <field name="name">fleet.catalogo.orig.creacion.inherit.mantenimiento.view.form</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="inherit_id" ref="fleet_mantenimiento.fleet_mantenimiento_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='indicador_actualizacion']" position="after">
                    <field name="origen_id" readonly="1"/>
                </xpath>
            </field>
        </record>

        <record id="fleet_mantenimiento.fleet_mantenimiento_action" model="ir.actions.act_window">
            <field name="name">Mantenimientos</field>
            <field name="res_model">fleet.mantenimiento</field>
            <field name="view_mode">list,form,kanban,pivot,graph</field>
            <field name="view_id" ref="fleet_mantenimiento.fleet_mantenimiento_view_list"/>
            <field name="context">{'default_origen_id': 2}</field>
        </record>
    </data>
</odoo>