<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="expediente_tipo_view_form" model="ir.ui.view">
            <field name="name">expediente.tipo.view.form</field>
            <field name="model">expediente.tipo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Tipo">
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="notificar_por_correo"/>
                            </group>
                        </group>
                        <group string="Archivos de vehículo">
                            <group>
                                <field name="factura_req" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="opcion_compra_req" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="Archivos de pólizas">
                            <group>
                                <field name="poliza_req" widget="boolean_toggle"/>
                            </group>
                            <group>
                                <field name="endoso_req" widget="boolean_toggle"/>
                            </group>
                        </group>
                        <group string="Contrato">
                                <field name="contrato_req" widget="boolean_toggle"/>
                        </group>
                        <notebook>
                            <page string="Adecuaciones">
                                <field name="tipo_adecuacion_ids"/>
                            </page>
                            <page string="Tramites">
                                <field name="tipo_tramite_ids"/>
                            </page>
                            <page string="Usuarios a notificar">
                                <field name="usuarios_notificar_ids"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="expediente_tipo_view_list" model="ir.ui.view">
            <field name="name">expediente.tipo.view.list</field>
            <field name="model">expediente.tipo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="factura_req"/>
                    <field name="opcion_compra_req"/>
                    <field name="poliza_req"/>
                    <field name="endoso_req"/>
                    <field name="contrato_req"/>
                </list>
            </field>
        </record>

        <record id="expediente_tipo_action" model="ir.actions.act_window">
            <field name="name">Tipo de expediente</field>
            <field name="res_model">expediente.tipo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="expediente_tipo_view_list"/>
        </record>
    </data>
</odoo>