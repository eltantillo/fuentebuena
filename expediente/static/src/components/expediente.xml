<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <div id="expediente_main" t-name="expediente.main" owl="1" t-ref="mainContainer">
        <header class="expediente-header">
            <div class="expediente-header__top">
                <div class="expediente-header__title">
                    <div class="expediente-header__icon">
                        <i class="fa fa-car"/>
                    </div>
                    <div>
                        <h1>Expediente de vehículos</h1>
                    </div>
                </div>
                <div class="expediente-header__stats">
                    <button type="button" class="expediente-stat expediente-stat--total">
                        <span>Total</span>
                        <t t-esc="state.vehiculos.length"/>
                    </button>
                    <button type="button" class="expediente-stat expediente-stat--incompleto">
                        <span>Incompletos</span>
                        <strong t-esc="this.state.expeIncompletosInt"/>
                    </button>
                    <button type="button" class="expediente-stat expediente-stat--incompleto"  t-on-click="() => this.descargarExcelFaltantes('incompleto')">
                        <i class="fa fa-download"/>
                    </button>
                    <button type="button" class="expediente-stat expediente-stat--completo">
                        <span>Completos</span>
                        <strong t-esc="this.state.expeCompletosInt"/>
                    </button>
                    <button type="button" class="expediente-stat expediente-stat--completo" t-on-click="() => this.descargarExcelFaltantes('completo')">
                        <i class="fa fa-download"/>
                    </button>
                </div>
            </div>

            <div class="expediente-header__filters">
                <div class="expediente-search">
                    <i class="fa fa-search"/>
                    <input type="text" placeholder="Buscar por VIN o placa..." t-on-input="_onSearchInput" t-model="state.searchQuery"/>
                </div>
                <div class="expediente-document-filter">
                    <select t-on-change="onChangeExpediente">
                        <option value="todos">Filtrar por: Expediente</option>
                        <t t-foreach="state.tipoExpedientes" t-as="expe" t-key="expe.id">
                            <option t-att-value="expe.id">
                                <t t-esc="expe.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="expediente-document-filter">
                    <select t-on-change="onChangePlaza">
                        <option value="todos">Filtrar por: Plaza</option>
                        <t t-foreach="state.plazas" t-as="plaza" t-key="plaza.id">
                            <option t-att-value="plaza.id">
                                <t t-esc="plaza.name"/>
                            </option>
                        </t>
                    </select>
                </div>
                <div class="expediente-document-filter">
                    <select t-on-change="onChangeDocumento">
                        <option value="todos">Filtrar por: Documento</option>
                        <t t-foreach="state.documento_filter" t-as="documento" t-key="documento">
                            <option t-att-value="documento">
                                <t t-esc="documento"/>
                            </option>
                        </t>
                    </select>
                </div>
            </div>

            <div class="expediente-header__legend">
                <span class="legend-title">Leyenda:</span>
                <span class="legend-item" style="cursor: pointer;"
                      t-att-class="state.filtrosActivos.includes('vigente') ? 'legend-item--active' : ''"
                      t-on-click="() => this.toggleFiltro('vigente')">
                    <i t-att-class="'legend-dot legend-dot--vigente' + (state.filtrosActivos.includes('vigente') ? ' is-on' : '')"/>
                    Vigente
                </span>
                <span class="legend-item" style="cursor: pointer;"
                      t-att-class="state.filtrosActivos.includes('falta subir') ? 'legend-item--active' : ''"
                      t-on-click="() => this.toggleFiltro('falta subir')">
                    <i t-att-class="'legend-dot legend-dot--faltante' + (state.filtrosActivos.includes('falta subir') ? ' is-on' : '')"/>
                    Falta subir
                </span>
                <span class="legend-item" style="cursor: pointer;"
                      t-att-class="state.filtrosActivos.includes('vencido') ? 'legend-item--active' : ''"
                      t-on-click="() => this.toggleFiltro('vencido')">
                    <i t-att-class="'legend-dot legend-dot--vencido' + (state.filtrosActivos.includes('vencido') ? ' is-on' : '')"/>
                    Vencido
                </span>
                <span class="legend-item" style="cursor: pointer;"
                      t-att-class="state.filtrosActivos.includes('sin registro') ? 'legend-item--active' : ''"
                      t-on-click="() => this.toggleFiltro('sin registro')">
                    <i t-att-class="'legend-dot legend-dot--no-existe' + (state.filtrosActivos.includes('sin registro') ? ' is-on' : '')"/>
                    Sin registro
                </span>
            </div>
        </header>

        <body>
            <div class="vehiculos-grid">
                <t t-foreach="paginatedList" t-as="vehiculo" t-key="vehiculo.id">
                    <div class="vehiculo-card">
                        <div class="vehiculo-card__header">
                            <div class="vehiculo-card__info">
                                <div class="vehiculo-card__vin">
                                    <t t-esc="vehiculo.vehiculo"/>
                                </div>
                                <div class="vehiculo-card__placa">
                                    <i class="fa fa-credit-card"/>
                                    <t t-esc="vehiculo.license_plate"/>
                                </div>
                                <div class="vehiculo-card__placa">
                                    <i class="fa fa-map-marker"/>
                                    <t t-esc="vehiculo.plaza"/>
                                </div>
                            </div>
                            <div t-att-class="{
                                'vehiculo-card__status-icon': true,
                                'vehiculo-card__status-icon--danger': !vehiculo.expediente,
                                'vehiculo-card__status-icon--success': vehiculo.expediente
                            }">
                                <i t-att-class="vehiculo.expediente ? 'fa fa-check-circle' : 'fa fa-exclamation-triangle'"/>
                            </div>
                        </div>

                        <div class="vehiculo-card__body">
                            <t t-if="vehiculo.expediente and !state.filtrosActivos.length and !state.selectedDocumento">
                                <div class="vehiculo-card__complete">
                                    <i class="fa fa-check"/>
                                    <span>Expediente completo</span>
                                </div>
                            </t>
                            <t t-else="">
                                <div class="vehiculo-card__documents">
                                    <t t-foreach="this.getDocumentosFiltrados(vehiculo)"
                                       t-as="documento"
                                       t-key="documento.faltante + (documento.motivo || '')">
                                        <div t-att-class="{
                                            'vehiculo-card__badge': true,
                                            'vehiculo-card__badge--vencido': documento.motivo == 'vencido',
                                            'vehiculo-card__badge--faltante': documento.motivo == 'falta subir',
                                            'vehiculo-card__badge--sin-registro': documento.motivo == 'sin registro',
                                            'vehiculo-card__badge--vigente': documento.motivo == 'vigente'
                                        }">
                                            <span>
                                                <t t-esc="documento.faltante"/>
                                            </span>
                                        </div>
                                    </t>
                                </div>
                            </t>
                        </div>

                        <div class="vehiculo-card__separator"/>

                        <div class="vehiculo-card__footer">
                            <div class="vehiculo-card__faltantes">
                                <t t-if="vehiculo.faltantes.length">
                                    <strong><t t-esc="vehiculo.faltantes.length"/></strong>
                                    <span>
                                        <t t-if="vehiculo.faltantes.length === 1">documento por atender</t>
                                        <t t-else="">documentos por atender</t>
                                    </span>
                                </t>
                                <t t-else="">
                                    <div class="vehiculo-card__footer-complete">
                                        <i class="fa fa-check"/> Expediente completo
                                    </div>
                                </t>
                            </div>
                            <button type="button" class="vehiculo-card__detail" t-on-click="() => this.abrirModal(vehiculo)">
                                Ver detalle <i class="fa fa-angle-right"/>
                            </button>
                        </div>
                    </div>
                </t>
            </div>

            <div class="expediente-pagination" t-if="totalPages > 1">
                <button type="button" class="expediente-pagination__btn" t-on-click="prevPage" t-att-disabled="state.currentPage === 1">
                    <i class="fa fa-chevron-left"/> Anterior
                </button>
                <span class="expediente-pagination__info">
                    Página <strong t-esc="state.currentPage"/> de <strong t-esc="totalPages"/>
                </span>
                <button type="button" class="expediente-pagination__btn" t-on-click="nextPage" t-att-disabled="state.currentPage === totalPages">
                    Siguiente <i class="fa fa-chevron-right"/>
                </button>
            </div>

            <t t-if="state.vehiculoSeleccionado">
                <div class="expediente-modal">
                    <div class="expediente-modal__backdrop" t-on-click="cerrarModal"/>
                    <div class="expediente-modal__content">
                        <div class="expediente-modal__handle"/>
                        <div class="expediente-modal__header">
                            <div>
                                <h2><t t-esc="state.vehiculoSeleccionado.vehiculo"/></h2>
                                <div class="expediente-modal__vin">Matricula: <t t-esc="state.vehiculoSeleccionado.license_plate"/></div>
                                <div class="expediente-modal__vin">Plaza: <t t-esc="state.vehiculoSeleccionado.plaza"/></div>
                                <div class="expediente-modal__vin">Etapa: <t t-esc="state.vehiculoSeleccionado.etapa"/></div>
                                <div class="expediente-modal__vin">Sub etapa: <t t-esc="state.vehiculoSeleccionado.sub_etapa"/></div>
                            </div>
                            <div style="display:flex; align-items:center; gap:8px;">
                                <button type="button" class="expediente-pagination__btn"
                                        t-on-click="descargarZip"
                                        t-att-disabled="state.isDownloadingZip">
                                    <i class="fa fa-file-archive-o"/>
                                    <t t-esc="state.isDownloadingZip ? 'Generando...' : 'Descargar ZIP'"/>
                                </button>
                                <button type="button" class="expediente-modal__close" t-on-click="cerrarModal">
                                    <i class="fa fa-times"/>
                                </button>
                            </div>
                        </div>

                        <div class="expediente-modal__documents">
                            <t t-if="state.isLoadingArchivos">
                                <div style="text-align:center; padding:24px; color:#7a8989;">
                                    Cargando documentos...
                                </div>
                            </t>
                            <t t-elif="state.archivosVehiculo">
                                <t t-foreach="['factura', 'opcion_compra', 'contrato']" t-as="clave" t-key="clave">
                                    <t t-if="state.archivosVehiculo[clave]">
                                        <div class="expediente-modal__document">
                                            <div class="expediente-modal__document-info">
                                                <div class="expediente-modal__document-name">
                                                    <t t-esc="state.archivosVehiculo[clave].name"/>
                                                </div>
                                                <div style="display:flex; align-items:center; gap:10px;">
                                                    <div class="expediente-modal__document-status expediente-modal__document-status--vigente">
                                                        <span>vigente</span>
                                                    </div>
                                                    <button type="button" class="vehiculo-card__detail"
                                                            title="Ver"
                                                            t-on-click="() => this.openPreview(state.archivosVehiculo[clave])">
                                                        <i class="fa fa-eye"/>
                                                    </button>
                                                    <button type="button" class="vehiculo-card__detail"
                                                            title="Descargar"
                                                            t-on-click="() => this.descargarArchivo(state.archivosVehiculo[clave])">
                                                        <i class="fa fa-download"/>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </t>
                                </t>
                                <t t-foreach="['polizas', 'tramites', 'adecuaciones']" t-as="grupo" t-key="grupo">
                                    <t t-if="state.archivosVehiculo[grupo]">
                                        <t t-foreach="state.archivosVehiculo[grupo]" t-as="doc" t-key="doc.id">
                                            <div class="expediente-modal__document">
                                                <div class="expediente-modal__document-info">
                                                    <div class="expediente-modal__document-name">
                                                        <t t-esc="doc.name"/>
                                                        <t t-if="doc.fecha_vencimiento">
                                                            <div class="expediente-modal__document-fecha">
                                                               Fecha de vencimiento: <t t-esc="doc.fecha_vencimiento"/>
                                                            </div>
                                                        </t>
                                                    </div>
                                                    <div style="display:flex; align-items:center; gap:10px;">
                                                        <div class="expediente-modal__document-status expediente-modal__document-status--vigente">
                                                            <span>vigente</span>
                                                        </div>
                                                        <button type="button" class="vehiculo-card__detail"
                                                                title="Ver"
                                                                t-on-click="() => this.openPreview(doc)">
                                                            <i class="fa fa-eye"/>
                                                        </button>
                                                        <button type="button" class="vehiculo-card__detail"
                                                                title="Descargar"
                                                                t-on-click="() => this.descargarArchivo(doc)">
                                                            <i class="fa fa-download"/>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </t>
                                </t>
                                <t t-foreach="state.archivosVehiculo.faltantes" t-as="falt" t-key="falt.faltante">
                                    <div class="expediente-modal__document">
                                        <div class="expediente-modal__document-info">
                                            <div class="expediente-modal__document-name">
                                                <t t-esc="falt.faltante"/>
                                            </div>
                                            <div t-att-class="{
                                                'expediente-modal__document-status': true,
                                                'expediente-modal__document-status--faltante': falt.motivo == 'falta subir',
                                                'expediente-modal__document-status--vencido': falt.motivo == 'vencido',
                                                'expediente-modal__document-status--sin-registro': falt.motivo == 'sin registro'
                                            }">
                                                <span><t t-esc="falt.motivo"/></span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </div>
            </t>

            <!-- Visor de PDF -->
            <t t-if="state.isOpen">
                <div class="expediente-modal" style="z-index: 1100;">
                    <div class="expediente-modal__backdrop" t-on-click="closePreview"/>
                    <div class="expediente-modal__content" style="max-width: 90vw; max-height: 92vh; width: 800px;">
                        <div class="expediente-modal__header">
                            <h2><t t-esc="state.title"/></h2>
                            <button type="button" class="expediente-modal__close" t-on-click="closePreview">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                        <iframe t-att-src="state.pdfUrl" style="width:100%; height:75vh; border:0;"/>
                    </div>
                </div>
            </t>
        </body>
    </div>
</templates>