<?xml version="1.0" encoding="UTF-8" ?>
<templates>
    <div id="expediente_main" t-name="expediente.main" owl="1" class="d-flex flex-column h-100 min-vh-100 p-3 p-md-4">
        <div class="card main-card border-0 shadow-sm rounded-4 flex-fill d-flex flex-column overflow-hidden">
            <div class="card-header border-bottom p-3 p-md-4 expediente-header">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-md-4 text-center text-md-start">
                        <h2 class="h5 h4-md font-weight-bold header-title text-white mb-0">
                            <i class="fa fa-car me-2 header-icon"/> Expediente de Vehículos
                        </h2>
                        <small class="header-subtitle text-white-50 d-block">Listado general de unidades registradas</small>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="input-group expediente-search-group">
                            <span class="input-group-text border-0 expediente-search-icon">
                                <i class="fa fa-search"/>
                            </span>
                            <input type="text"
                                   t-ref="searchInput"
                                   class="form-control border-0 text-white shadow-none expediente-search-input"
                                   placeholder="Buscar por VIN..."
                                   t-on-keydown="_onSearchKeydown"/>
                            <button t-if="state.isSearching"
                                    type="button"
                                    class="btn expediente-clear-btn"
                                    t-on-click="clearSearch">
                                <i class="fa fa-times"/>
                            </button>
                        </div>
                    </div>
                    <div class="col-12 col-sm-6 col-md-3">
                        <div class="d-flex flex-column flex-sm-row gap-2">
                            <div class="expediente-select-wrapper w-100">
                                <i class="fa fa-map-marker expediente-select-icon"/>
                                <select class="form-select expediente-select" t-on-change="on_change_plaza">
                                    <option value="">Todas las plazas</option>
                                    <t t-foreach="state.plazas" t-as="plaza" t-key="plaza.id">
                                        <option t-att-value="plaza.id">
                                            <t t-esc="plaza.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <div class="expediente-select-wrapper w-100" t-on-change="onChangeExpediente">
                                <i class="fa fa-file expediente-select-icon"/>
                                <select class="form-select expediente-select">
                                    <option value="">Tipo de expediente</option>
                                    <t t-foreach="state.tipoExpedientes" t-as="expe" t-key="expe.id">
                                        <option t-att-value="expe.id">
                                            <t t-esc="expe.name"/>
                                        </option>
                                    </t>
                                </select>
                            </div>
                            <t t-if="state.mostrarEstExpe">
                                <div class="expediente-select-wrapper w-100" t-on-change="onChangeEstadoExpe">
                                    <i class="fa fa-file expediente-select-icon"/>
                                    <select class="form-select expediente-select">
                                        <option value="">Estado de expediente</option>
                                        <option value="completo">Completo</option>
                                        <option value="incompleto">Incompleto</option>
                                    </select>
                                </div>
                            </t>
                        </div>
                    </div>
                    <div class="row d-flex justify-content-between mt-2">
                        <div class="col-4 text-center text-md-end">
                            <span class="badge px-3 py-2 fs-6 rounded-pill expediente-badge w-100 w-md-auto"
                                  title="Ver todos los vehículos"
                                  t-on-click="verTodos">
                                Total: <strong t-esc="state.totalVehiculos"/>
                            </span>
                        </div>
                        <div class="col-4 text-center text-md-end">
                            <span t-attf-class="badge px-3 py-2 fs-6 rounded-pill expediente-badge-danger w-100 w-md-auto {{ !state.mostrarEstExpe ? 'is-disabled' : '' }}"
                                  title="Filtrar incompletos y descargar Excel de faltantes"
                                  t-on-click="() => this.onClickEstadoBadge('incompleto')">
                                Incompletos: <strong t-esc="state.expeIncompletos.length"/>
                            </span>
                        </div>
                        <div class="col-4 text-center text-md-end">
                            <span t-attf-class="badge px-3 py-2 fs-6 rounded-pill expediente-badge-info w-100 w-md-auto {{ !state.mostrarEstExpe ? 'is-disabled' : '' }}"
                                  title="Filtrar completos y descargar Excel"
                                  t-on-click="() => this.onClickEstadoBadge('completo')">
                                Completos: <strong t-esc="state.expeCompletos.length"/>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card-body p-3 p-md-4 flex-fill overflow-auto d-flex flex-column">
                <t t-if="state.currentView === 'vehiculos'">
                    <div t-if="state.isLoading" class="d-flex justify-content-center align-items-center h-100">
                        <i class="fa fa-spinner fa-spin fa-2x text-muted"/>
                    </div>
                    <div t-elif="state.isSearching and state.visibleList.length === 0"
                         class="d-flex flex-column justify-content-center align-items-center h-100 text-muted">
                        <i class="fa fa-search fa-2x mb-2"/>
                        <span>No se encontraron vehículos con "<t t-esc="state.searchTerm"/>"</span>
                    </div>
                    <t t-else="">
                        <div class="row g-3 g-md-4">
                            <t t-foreach="state.visibleList" t-as="vehiculo" t-key="vehiculo.id">
                                <div class="col-6 col-sm-6 col-md-4 col-lg-3 col-xl-2"   t-on-click="() => cambiarVista(vehiculo)">
                                    <a href="#"
                                       t-attf-class="vehiculo-card text-decoration-none d-flex flex-column align-items-center justify-content-center p-3 rounded-3 text-center h-100 shadow-sm {{ state.isSearching ? 'is-highlighted' : '' }} {{ state.mostrarEstExpe ? ('status-' + (state.validacionMap[vehiculo.id] and state.validacionMap[vehiculo.id].estado or '')) : '' }}"
                                       t-att-title="state.mostrarEstExpe and state.validacionMap[vehiculo.id] ? (state.validacionMap[vehiculo.id].estado === 'completo' ? 'Expediente completo' : 'Faltan: ' + state.validacionMap[vehiculo.id].faltantes.join(', ')) : (vehiculo.vin_sn or '')">
                                        <t t-if="state.mostrarEstExpe and state.validacionMap[vehiculo.id]">
                                            <span t-attf-class="status-chip">
                                                <i t-attf-class="fa {{ state.validacionMap[vehiculo.id].estado === 'completo' ? 'fa-check' : 'fa-exclamation' }}"/>
                                            </span>
                                        </t>
                                        <div class="icon-wrapper mb-2 rounded-circle p-3 d-flex align-items-center justify-content-center">
                                            <i class="fa fa-folder-open fa-2x"/>
                                        </div>
                                        <span class="fw-bold vehiculo-title text-truncate w-100 small"
                                              t-att-title="vehiculo.vin_sn or ''"
                                              t-esc="vehiculo.vin_sn or 'Sin VIN'"/>
                                        <span class="vehiculo-subtitle extra-small mt-1"><t t-esc="vehiculo.license_plate"/></span>
                                    </a>
                                </div>
                            </t>
                        </div>

                        <div t-if="!state.isSearching" class="d-flex justify-content-center align-items-center gap-3 mt-4 pt-3 expediente-pagination">
                            <button class="btn btn-sm expediente-page-btn"
                                    t-att-disabled="state.currentPage === 1"
                                    t-on-click="prevPage">
                                <i class="fa fa-chevron-left"/> Anterior
                            </button>
                            <span class="expediente-page-info small">
                                Página <strong t-esc="state.currentPage"/> de <t t-esc="state.totalPages"/>
                                <span class="text-muted"> — <t t-esc="state.totalVehiculos"/> vehículos en total</span>
                            </span>
                            <button class="btn btn-sm expediente-page-btn"
                                    t-att-disabled="state.currentPage === state.totalPages"
                                    t-on-click="nextPage">
                                Siguiente <i class="fa fa-chevron-right"/>
                            </button>
                        </div>
                    </t>
                </t>

                <t t-elif="state.currentView === 'archivos'">
                    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                        <div class="d-flex align-items-center">
                            <button class="btn expediente-page-btn me-3"
                                    t-on-click="goBack">
                                <i class="fa fa-arrow-left"/>
                            </button>
                            <div>
                                <h5 class="mb-0 fw-bold" style="color: black;">
                                    <i class="fa fa-folder-open header-icon me-2"/>
                                    <t t-esc="state.vehiculo.vin_sn"/>
                                </h5>
                                <small class="expediente-page-info">
                                    <t t-esc="state.vehiculo.license_plate"/>
                                </small>
                            </div>
                        </div>
                        <button class="btn expediente-page-btn"
                                t-att-disabled="state.isDownloadingZip"
                                t-on-click="descargarZip">
                            <i t-attf-class="fa {{ state.isDownloadingZip ? 'fa-spinner fa-spin' : 'fa-file-archive-o' }} me-2"/>
                            Descargar ZIP
                        </button>
                    </div>

                    <t t-if="state.idExpediente and state.archivos.faltantes and state.archivos.faltantes.length">
                        <div class="expediente-alert expediente-alert-danger rounded-3 p-3 mb-4">
                            <div class="d-flex align-items-center mb-2">
                                <i class="fa fa-exclamation-triangle me-2"/>
                                <span class="fw-bold">Expediente incompleto — faltan <t t-esc="state.archivos.faltantes.length"/> documento(s)</span>
                            </div>
                            <ul class="mb-0 ps-4">
                                <t t-foreach="state.archivos.faltantes" t-as="falta" t-key="falta">
                                    <li t-esc="falta"/>
                                </t>
                            </ul>
                        </div>
                    </t>
                    <t t-elif="state.idExpediente and state.archivos.faltantes and state.archivos.faltantes.length === 0">
                        <div class="expediente-alert expediente-alert-success rounded-3 p-3 mb-4 d-flex align-items-center">
                            <i class="fa fa-check-circle me-2"/>
                            <span class="fw-bold">Expediente completo</span>
                        </div>
                    </t>

                    <t t-if="state.archivos.adecuaciones">
                        <div class="text-center">
                            <h2 class="h2 h4-md font-weight-bold header-title mb-0">
                                Adecuaciones
                            </h2>
                        </div>
                        <div class="list-group">
                            <t t-foreach="state.archivos.adecuaciones"
                               t-as="archivo"
                               t-key="archivo.id">
                                <div class="list-group-item border rounded-3 mb-2 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-wrapper rounded-circle d-flex align-items-center justify-content-center me-3"
                                                 style="width:48px;height:48px;">

                                                <i class="fa fa-file-pdf-o fa-lg"/>
                                            </div>
                                            <div>
                                                <div class="fw-bold">
                                                    <t t-esc="archivo.name"/>
                                                </div>
                                                <small class="vehiculo-subtitle">
                                                    <t t-esc="((archivo.size || 0) / 1000000).toFixed(2)"/> MB
                                                </small>
                                            </div>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm expediente-page-btn me-2"  t-on-click="() => openPreview(archivo)">
                                                <i class="fa fa-eye"/>
                                            </button>
                                            <button class="btn btn-sm expediente-page-btn" t-on-click="() => descargarArchivo(archivo)">
                                                <i class="fa fa-download"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="state.archivos.contrato">
                        <div class="text-center">
                            <h2 class="h2 h4-md font-weight-bold header-title mb-0">
                                Contrato
                            </h2>
                        </div>
                        <div class="list-group">
                            <div class="list-group-item border rounded-3 mb-2 py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-wrapper rounded-circle d-flex align-items-center justify-content-center me-3"
                                             style="width:48px;height:48px;">

                                            <i class="fa fa-file-pdf-o fa-lg"/>
                                        </div>
                                        <div>
                                            <div class="fw-bold">
                                                <t t-esc="state.archivos.contrato.name"/>
                                            </div>
                                            <small class="vehiculo-subtitle">
                                                 <t t-esc="((state.archivos.contrato.size || 0) / 1000000).toFixed(2)"/> MB
                                            </small>
                                        </div>
                                    </div>
                                    <div>
                                        <button class="btn btn-sm expediente-page-btn me-2" t-on-click="() => openPreview(state.archivos.contrato)">
                                            <i class="fa fa-eye"/>
                                        </button>
                                        <button class="btn btn-sm expediente-page-btn"  t-on-click="() => descargarArchivo(state.archivos.contrato)">
                                            <i class="fa fa-download"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.archivos.factura">
                        <div class="text-center">
                            <h2 class="h2 h4-md font-weight-bold header-title mb-0">
                                Factura
                            </h2>
                        </div>
                        <div class="list-group">
                            <div class="list-group-item border rounded-3 mb-2 py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-wrapper rounded-circle d-flex align-items-center justify-content-center me-3"
                                             style="width:48px;height:48px;">

                                            <i class="fa fa-file-pdf-o fa-lg"/>
                                        </div>
                                        <div>
                                            <div class="fw-bold">
                                                <t t-esc="state.archivos.factura.name"/>
                                            </div>
                                            <small class="vehiculo-subtitle">
                                             <t t-esc="((state.archivos.factura.size || 0) / 1000000).toFixed(1)"/> MB
                                            </small>
                                        </div>
                                    </div>
                                    <div>
                                        <button class="btn btn-sm expediente-page-btn me-2" t-on-click="() => openPreview(state.archivos.factura)">
                                            <i class="fa fa-eye"/>
                                        </button>
                                        <button class="btn btn-sm expediente-page-btn"  t-on-click="() => descargarArchivo(state.archivos.factura)">
                                            <i class="fa fa-download"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.archivos.opcion_compra">
                        <div class="text-center">
                            <h2 class="h2 h4-md font-weight-bold header-title mb-0">
                                Opción a compra
                            </h2>
                        </div>
                        <div class="list-group">
                            <div class="list-group-item border rounded-3 mb-2 py-3">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class="d-flex align-items-center">
                                        <div class="icon-wrapper rounded-circle d-flex align-items-center justify-content-center me-3"
                                             style="width:48px;height:48px;">

                                            <i class="fa fa-file-pdf-o fa-lg"/>
                                        </div>
                                        <div>
                                            <div class="fw-bold">
                                                <t t-esc="state.archivos.opcion_compra.name"/>
                                            </div>
                                            <small class="vehiculo-subtitle">
                                             <t t-esc="((state.archivos.opcion_compra.size || 0) / 1000000).toFixed(1)"/> MB
                                            </small>
                                        </div>
                                    </div>
                                    <div>
                                        <button class="btn btn-sm expediente-page-btn me-2" t-on-click="() => openPreview(state.archivos.opcion_compra)">
                                            <i class="fa fa-eye"/>
                                        </button>
                                        <button class="btn btn-sm expediente-page-btn"  t-on-click="() => descargarArchivo(state.archivos.opcion_compra)">
                                            <i class="fa fa-download"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                    <t t-if="state.archivos.polizas">
                        <div class="text-center">
                            <h2 class="h2 h4-md font-weight-bold header-title mb-0">
                                Pólizas
                            </h2>
                        </div>
                        <div class="list-group">
                            <t t-foreach="state.archivos.polizas"
                               t-as="archivo"
                               t-key="archivo.id">
                                <div class="list-group-item border rounded-3 mb-2 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-wrapper rounded-circle d-flex align-items-center justify-content-center me-3"
                                                 style="width:48px;height:48px;">

                                                <i class="fa fa-file-pdf-o fa-lg"/>
                                            </div>
                                            <div>
                                                <div class="fw-bold">
                                                    <t t-esc="archivo.name"/>
                                                </div>
                                                <small class="vehiculo-subtitle">
                                                    <t t-esc="((archivo.size || 0) / 1000000).toFixed(2)"/> MB
                                                </small>
                                            </div>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm expediente-page-btn me-2"  t-on-click="() => openPreview(archivo)">
                                                <i class="fa fa-eye"/>
                                            </button>
                                            <button class="btn btn-sm expediente-page-btn" t-on-click="() => descargarArchivo(archivo)">
                                                <i class="fa fa-download"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="state.archivos.tramites">
                        <div class="text-center">
                            <h2 class="h2 h4-md font-weight-bold header-title mb-0">
                                Trámites
                            </h2>
                        </div>
                        <div class="list-group">
                            <t t-foreach="state.archivos.tramites"
                               t-as="archivo"
                               t-key="archivo.id">
                                <div class="list-group-item border rounded-3 mb-2 py-3">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="d-flex align-items-center">
                                            <div class="icon-wrapper rounded-circle d-flex align-items-center justify-content-center me-3"
                                                 style="width:48px;height:48px;">

                                                <i class="fa fa-file-pdf-o fa-lg"/>
                                            </div>
                                            <div>
                                                <div class="fw-bold">
                                                    <t t-esc="archivo.name"/>
                                                </div>
                                                <small class="vehiculo-subtitle">
                                                    <t t-esc="((archivo.size || 0) / 1000000).toFixed(2)"/> MB
                                                </small>
                                            </div>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm expediente-page-btn me-2"  t-on-click="() => openPreview(archivo)">
                                                <i class="fa fa-eye"/>
                                            </button>
                                            <button class="btn btn-sm expediente-page-btn" t-on-click="() => descargarArchivo(archivo)">
                                                <i class="fa fa-download"/>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </t>
                    <t t-if="state.isOpen">
                        <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.6);">
                            <div class="modal-dialog modal-xl modal-dialog-centered" style="height: 85vh;">
                                <div class="modal-content h-100">
                                    <div class="modal-header">
                                        <h5 class="modal-title" t-esc="state.title"/>
                                        <button type="button" class="btn-close" t-on-click="closeModal"/>
                                    </div>
                                    <div class="modal-body p-0">
                                        <iframe t-att-src="state.pdfUrl" class="w-100 h-100" frameborder="0"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </t>
            </div>
        </div>
    </div>
</templates>