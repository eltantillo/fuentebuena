<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="promesa_ecv_proc_nomina_view_list" model="ir.ui.view">
        <field name="name">promesa.p.ecv.proc.nomina.view.list</field>
        <field name="model">promesa.p.ecv.proc.nomina</field>
        <field name="arch" type="xml">
            <list>
                <field name="id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="promesa_ecv_proc_nomina_view_form" model="ir.ui.view">
        <field name="name">promesa.p.ecv.proc.nomina.view.form</field>
        <field name="model">promesa.p.ecv.proc.nomina</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promesa_ecv_proc_nomina_action" model="ir.actions.act_window">
        <field name="name">Ecv Proc Nómina</field>
        <field name="res_model">promesa.p.ecv.proc.nomina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="promesa_ecv_proc_nomina_view_list"/>
    </record>
</odoo>