<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="promesa_p_zona_view_list" model="ir.ui.view">
        <field name="name">promesa.p.zona.view.list</field>
        <field name="model">promesa.p.zona</field>
        <field name="arch" type="xml">
            <list string="Zonas">
                <field name="zona_id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="promesa_p_zona_view_form" model="ir.ui.view">
        <field name="name">promesa.p.zona.view.form</field>
        <field name="model">promesa.p.zona</field>
        <field name="arch" type="xml">
            <form string="Zona">
                <sheet>
                    <group>
                        <field name="zona_id"/>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promesa_p_zona_action" model="ir.actions.act_window">
        <field name="name">Zonas</field>
        <field name="res_model">promesa.p.zona</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="promesa_p_zona_view_list"/>
    </record>
</odoo>