<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="promesa_p_frecuencia_nomina_view_list" model="ir.ui.view">
        <field name="name">promesa.p.frecuencia.nomina.view.list</field>
        <field name="model">promesa.p.frecuencia.nomina</field>
        <field name="arch" type="xml">
            <list string="Frecuencia Nómina">
                <field name="id"/>
                <field name="name"/>
                <field name="nombre_corto"/>
                <field name="factor"/>
            </list>
        </field>
    </record>

    <record id="promesa_p_frecuencia_nomina_view_form" model="ir.ui.view">
        <field name="name">promesa.p.frecuencia.nomina.view.form</field>
        <field name="model">promesa.p.frecuencia.nomina</field>
        <field name="arch" type="xml">
            <form string="Frecuencia Nómina">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="nombre_corto"/>
                        <field name="factor"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promesa_p_frecuencia_nomina_action" model="ir.actions.act_window">
        <field name="name">Frecuencia Nómina</field>
        <field name="res_model">promesa.p.frecuencia.nomina</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="promesa_p_frecuencia_nomina_view_list"/>
    </record>
</odoo>