<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="promesa_p_rol_view_list" model="ir.ui.view">
        <field name="name">promesa.p.rol.view.list</field>
        <field name="model">promesa.p.rol</field>
        <field name="arch" type="xml">
            <list string="Roles">
                <field name="name"/>
                <field name="employee_ids"/>
            </list>
        </field>
    </record>

    <record id="promesa_p_rol_view_form" model="ir.ui.view">
        <field name="name">promesa.p.rol.view.form</field>
        <field name="model">promesa.p.rol</field>
        <field name="arch" type="xml">
            <form string="Rol">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="employee_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promesa_p_rol_action" model="ir.actions.act_window">
        <field name="name">Roles</field>
        <field name="res_model">promesa.p.rol</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>