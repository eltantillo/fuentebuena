<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="promesa_p_convenio_view_list" model="ir.ui.view">
        <field name="name">promesa.p.convenio.view.list</field>
        <field name="model">promesa.p.convenio</field>
        <field name="arch" type="xml">
            <list string="Convenios">
                <field name="id"/>
                <field name="name"/>
                <field name="pk_cat_convenio"/>
                <field name="celula_id"/>
                <field name="celula_name"/>
            </list>
        </field>
    </record>

    <record id="promesa_p_convenio_view_form" model="ir.ui.view">
        <field name="name">promesa.p.convenio.view.form</field>
        <field name="model">promesa.p.convenio</field>
        <field name="arch" type="xml">
            <form string="Convenio">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="pk_cat_convenio"/>
                        <field name="celula_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promesa_p_convenio_action" model="ir.actions.act_window">
        <field name="name">Convenios</field>
        <field name="res_model">promesa.p.convenio</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="promesa_p_convenio_view_list"/>
    </record>

</odoo>