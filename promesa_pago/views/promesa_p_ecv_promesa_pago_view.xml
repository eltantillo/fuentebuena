<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="promesa_p_ecv_promesa_pago_view_list" model="ir.ui.view">
        <field name="name">promesa.p.ecv.promesa.pago.view.list</field>
        <field name="model">promesa.p.ecv.promesa.pago</field>
        <field name="arch" type="xml">
            <list string="Promesas de Pago">
                <field name="id"/>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="promesa_p_ecv_promesa_pago_view_form" model="ir.ui.view">
        <field name="name">promesa.p.ecv.promesa.pago.view.form</field>
        <field name="model">promesa.p.ecv.promesa.pago</field>
        <field name="arch" type="xml">
            <form string="Promesa de Pago">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="promesa_p_ecv_promesa_pago_action" model="ir.actions.act_window">
        <field name="name">ECV Promesas de Pago</field>
        <field name="res_model">promesa.p.ecv.promesa.pago</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="promesa_p_ecv_promesa_pago_view_list"/>
    </record>
</odoo>