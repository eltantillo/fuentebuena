<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Form View for Asset Vendor -->
    <record id="view_asset_vendor_form" model="ir.ui.view">
        <field name="name">asset.vendor.form</field>
        <field name="model">asset.vendor</field>
        <field name="arch" type="xml">
            <form string="Asset Vendor">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_assets" type="object"
                                class="oe_stat_button" icon="fa-cubes">
                            <field name="asset_count" widget="statinfo" string="Assets"/>
                        </button>
                        <button name="action_view_maintenance" type="object"
                                class="oe_stat_button" icon="fa-wrench">
                            <field name="maintenance_count" widget="statinfo" string="Maintenance"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Vendor Name"/></h1>
                    </div>
                    <group>
                        <group string="Vendor Profile">
                            <field name="address"/>
                            <field name="location"/>
                            <field name="website" widget="url"/>
                            <field name="tax_id"/>
                            <field name="rating"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Contact Information">
                            <field name="seller"/>
                            <field name="contact_phone" widget="phone"/>
                            <field name="contact_email" widget="email"/>
                        </group>
                    </group>
                    <group>
                        <group string="Service Capabilities">
                            <field name="repair_service"/>
                            <field name="maintenance_service"/>
                            <field name="additional_services"/>
                        </group>
                        <group string="Notes">
                            <field name="notes" nolabel="1" placeholder="Internal notes about this vendor..."/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View for Asset Vendor -->
    <record id="view_asset_vendor_tree" model="ir.ui.view">
        <field name="name">asset.vendor.tree</field>
        <field name="model">asset.vendor</field>
        <field name="arch" type="xml">
            <list string="Asset Vendors">
                <field name="name"/>
                <field name="seller"/>
                <field name="contact_phone"/>
                <field name="contact_email"/>
                <field name="location"/>
                <field name="rating" optional="show"/>
                <field name="repair_service"/>
                <field name="maintenance_service"/>
                <field name="asset_count" string="Assets"/>
            </list>
        </field>
    </record>

    <!-- Search View for Vendors -->
    <record id="view_asset_vendor_search" model="ir.ui.view">
        <field name="name">asset.vendor.search</field>
        <field name="model">asset.vendor</field>
        <field name="arch" type="xml">
            <search string="Vendors">
                <field name="name"/>
                <field name="seller"/>
                <field name="contact_email"/>
                <filter string="Repair Services" name="repair" domain="[('repair_service', '=', True)]"/>
                <filter string="Maintenance Services" name="maintenance" domain="[('maintenance_service', '=', True)]"/>
            </search>
        </field>
    </record>

    <!-- Action for Asset Vendor -->
    <record id="action_asset_vendor" model="ir.actions.act_window">
        <field name="name">Vendors</field>
        <field name="res_model">asset.vendor</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first vendor
            </p>
        </field>
    </record>

    <!-- Menu Item for Asset Vendor -->
    <menuitem id="menu_asset_vendor_root"
              name="Vendors"
              groups="vendor_user_group,vendor_admin_group,base.group_system"
              parent="menu_asset_root"
              action="action_asset_vendor"
              sequence="20"/>

</odoo>
