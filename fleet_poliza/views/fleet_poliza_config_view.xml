<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_poliza_config_view_form" model="ir.ui.view">
            <field name="name">fleet.poliza.config.view.form</field>
            <field name="model">fleet.poliza.config</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="plaza_id"/>
                            <field name="tipo_poliza_id"/>
                            <field name="proveedor_id"/>
                            <field name="tipo_cobertura_id"/>
                            <field name="tipo_valor_id"/>
                            <field name="prima_neta"/>
                            <field name="gasto_expedicion"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="fleet_poliza_config_view_list" model="ir.ui.view">
            <field name="name">fleet.poliza.config.view.list</field>
            <field name="model">fleet.poliza.config</field>
            <field name="arch" type="xml">
                <list>
                    <field name="plaza_id"/>
                    <field name="tipo_poliza_id"/>
                    <field name="proveedor_id"/>
                    <field name="tipo_cobertura_id"/>
                    <field name="tipo_valor_id"/>
                    <field name="prima_neta"/>
                    <field name="gasto_expedicion"/>
                </list>
            </field>
        </record>

        <record id="fleet_poliza_config_action" model="ir.actions.act_window">
            <field name="name">Datos default / Póliza</field>
            <field name="res_model">fleet.poliza.config</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="fleet_poliza_config_view_list"/>
        </record>
    </data>
</odoo>