<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_tecno_peticion_bloqueo_view_form" model="ir.ui.view">
            <field name="name">fleet.tecno.peticion.bloqueo.view.form</field>
            <field name="model">fleet.tecno.peticion.bloqueo</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="estado_id" widget="statusbar"  options="{'clickable': True}" readonly="1"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Datos de petición">
                                <field name="tipo_operacion" readonly="1"/>
                                <field name="cod_area_solicitante" readonly="1"/>
                                <field name="id_usuario" readonly="1"/>
                                <field name="motivo_solicitud" readonly="1"/>
                                <field name="fecha_hora_req" readonly="1"/>
                                <field name="codigo_respuesta_id" readonly="1"/>
                            </group>
                            <group string="Información del vehiculo">
                                <field name="numero_contrato" readonly="1"/>
                                <field name="vehiculo_contrato_id" readonly="1"/>
                                <field name="vin_sn"/>
                            </group>
                        </group>
                        <group string="Respuesta Tecnocontrol">
                            <field name="codigo"/>
                            <field name="mensaje"/>
                            <field name="resumen"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="fleet_tecno_peticion_bloqueo_view_list" model="ir.ui.view">
            <field name="name">fleet.tecno.peticion.bloqueo.view.list</field>
            <field name="model">fleet.tecno.peticion.bloqueo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="tipo_operacion"/>
                    <field name="numero_contrato"/>
                    <field name="cod_area_solicitante"/>
                    <field name="id_usuario"/>
                    <field name="motivo_solicitud"/>
                    <field name="fecha_hora_req"/>
                </list>
            </field>
        </record>

        <record id="fleet_tecno_peticion_bloqueo_action" model="ir.actions.act_window">
            <field name="name">Peticiones de bloqueo/desbloqueo</field>
            <field name="res_model">fleet.tecno.peticion.bloqueo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="fleet_tecno_peticion_bloqueo_view_list"/>
        </record>
    </data>
</odoo>