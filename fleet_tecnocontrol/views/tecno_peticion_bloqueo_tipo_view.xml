<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="tecno_peticion_bloqueo_tipo_view_form" model="ir.ui.view">
            <field name="name">tecno.peticion.bloqueo.tipo.view.form</field>
            <field name="model">agenda.peticion.bloqueo.tipo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="tecno_peticion_bloqueo_tipo_view_list" model="ir.ui.view">
            <field name="name">tecno.peticion.bloqueo.tipo.view.list</field>
            <field name="model">agenda.peticion.bloqueo.tipo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="tecno_peticion_bloqueo_tipo_action" model="ir.actions.act_window">
            <field name="name">Tipo de acción</field>
            <field name="res_model">agenda.peticion.bloqueo.tipo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref=""/>
        </record>
    </data>
</odoo>