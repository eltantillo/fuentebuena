<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_tecno_no_gps_view_list" model="ir.ui.view">
            <field name="name">fleet.tecno.no.gps.view.list</field>
            <field name="model">fleet.tecno.no.gps</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="id_gps"/>
                    <field name="vin_sn"/>
                </list>
            </field>
        </record>

        <record id="fleet_tecno_no_gps_action" model="ir.actions.act_window">
            <field name="name">Gps sin vehículos</field>
            <field name="res_model">fleet.tecno.no.gps</field>
            <field name="view_mode">list</field>
            <field name="view_id" ref="fleet_tecno_no_gps_view_list"/>
        </record>
    </data>
</odoo>