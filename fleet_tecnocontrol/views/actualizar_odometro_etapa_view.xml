<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="actualizar_odometro_etapa_view_form" model="ir.ui.view">
            <field name="name">actualizar.odometro.etapa.view.form</field>
            <field name="model">actualizar.odometro.etapa</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="actualizar_odometro_etapa_view_list" model="ir.ui.view">
            <field name="name">actualizar.odometro.etapa.view.list</field>
            <field name="model">actualizar.odometro.etapa</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="actualizar_odometro_etapa_action" model="ir.actions.act_window">
            <field name="name">Etapas de odometro</field>
            <field name="res_model">actualizar.odometro.etapa</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="actualizar_odometro_etapa_view_list"/>
        </record>
    </data>
</odoo>