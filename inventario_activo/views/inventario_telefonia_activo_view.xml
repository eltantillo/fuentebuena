<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_telefonia_activo_view_form" model="ir.ui.view">
            <field name="name">inventario.telefonia.activo.view.form</field>
            <field name="model">inventaro.telefonia.activo</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="etapa_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="logo"/>
                            </group>
                        </group>
                        <field name="mostrar_baja" invisible="1"/>
                        <group string="Información de Baja" invisible="mostrar_baja">
                            <field name="fecha_baja"/>
                            <field name="motivo_baja"/>
                        </group>
                        <group>
                            <group string="Datos del equipo">
                                <field name="color"/>
                                <field name="imei"/>
                                <field name="linea_asignada"/>
                                <field name="modelo_id"/>
                                <field name="fabricante_id"/>
                                <field name="proveedor_id"/>
                                <field name="active"/>
                            </group>
                            <field name="mostrar_asignacion" invisible="1"/>
                            <group string="Información de asignación" invisible="mostrar_asignacion">
                                <field name="empleado_id"/>
                                <field name="puesto_id"/>
                                <field name="fecha_asignacion"/>
                            </group>
                            <field name="mostrar_stock" invisible="1"/>
                            <group string="Información de stock" invisible="mostrar_stock">
                                <field name="fecha_ingreso_stock"/>
                                <field name="ubicacion_stock_id"/>
                            </group>
                        </group>
                        <group string="Especificaciones">
                            <field name="memoria_ram"/>
                            <field name="mac_wifi"/>
                            <field name="almacenamiento"/>
                            <field name="capacidad_bateria"/>
                            <field name="camara"/>
                        </group>
                        <notebook>
                            <page string="Adquisición">
                                <group>
                                    <field name="fecha_adquisicion"/>
                                    <field name="importe"/>
                                    <field name="iva"/>
                                    <field name="total"/>
                                    <field name="esquema_ad_id"/>
                                    <field name="num_plazos"/>
                                </group>
                            </page>
                            <page string="Resguardo">
                                <group>
                                    <field name="resguardo_attach"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="inventario_telefonia_activo_view_list" model="ir.ui.view">
            <field name="name">inventario.telefonia.activo.view.list</field>
            <field name="model">inventaro.telefonia.activo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="imei"/>
                    <field name="create_uid"/>
                    <field name="create_date"/>
                    <field name="name"/>
                    <field name="fabricante_id"/>
                    <field name="modelo_id"/>
                    <field name="etapa_id"/>
                    <field name="ubicacion_stock_id"/>
                    <field name="fecha_ingreso_stock"/>
                    <field name="color"/>
                    <field name="empleado_id"/>
                    <field name="puesto_id"/>
                </list>
            </field>
        </record>

        <record id="inventario_telefonia_activo_action" model="ir.actions.act_window">
            <field name="name">Inventario - Telefonía activo</field>
            <field name="res_model">inventaro.telefonia.activo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="inventario_telefonia_activo_view_list"/>
        </record>
    </data>
</odoo>