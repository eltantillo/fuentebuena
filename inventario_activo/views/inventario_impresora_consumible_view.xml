<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_impresora_consumible_view_form" model="ir.ui.view">
            <field name="name">inventario.impresora.consumible.view.form</field>
            <field name="model">inventario.impresora.consumible</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="inventario_impresora_consumible_view_list" model="ir.ui.view">
            <field name="name">inventario.impresora.consumible.view.list</field>
            <field name="model">inventario.impresora.consumible</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="inventario_impresora_consumible_action" model="ir.actions.act_window">
            <field name="name">Inventario - Impresora consumible</field>
            <field name="res_model">inventario.impresora.consumible</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="inventario_impresora_consumible_view_list"/>
        </record>
    </data>
</odoo>