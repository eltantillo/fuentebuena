<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_computo_almacenamiento_view_form" model="ir.ui.view">
            <field name="name">inventario.computo.almacenamiento.view.form</field>
            <field name="model">inventario.computo.almacenamiento</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <gorup>
                            <field name="name"/>
                        </gorup>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="inventario_computo_almacenamiento_view_list" model="ir.ui.view">
            <field name="name">inventario.computo.almacenamiento.view.form</field>
            <field name="model">inventario.computo.almacenamiento</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="inventario_computo_almacenamiento_action" model="ir.actions.act_window">
            <field name="name">Inventario - Computo almacenamiento</field>
            <field name="res_model">inventario.computo.almacenamiento</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="inventario_computo_almacenamiento_view_list"/>
        </record>
    </data>
</odoo>