<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_modelo_view_form" model="ir.ui.view">
            <field name="name">inventario.modelo.view.form</field>
            <field name="model">inventario.modelo</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="fabricante_id"/>
                                <field name="year"/>
                            </group>
                            <group>
                                <field name="logo" widget="image"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="inventario_modelo_view_list" model="ir.ui.view">
            <field name="name">inventario.modelo.view.list</field>
            <field name="model">inventario.modelo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="fabricante_id"/>
                </list>
            </field>
        </record>

        <record id="inventario_modelo_action" model="ir.actions.act_window">
            <field name="name">Inventario - Modelo</field>
            <field name="res_model">inventario.modelo</field>
            <field name="view_mode">form,list</field>
            <field name="view_id" ref="inventario_modelo_view_list"/>
        </record>
    </data>
</odoo>