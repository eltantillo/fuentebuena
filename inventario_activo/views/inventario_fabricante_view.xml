<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_fabricante_view_form" model="ir.ui.view">
            <field name="name">inventario_fabricante.view.form</field>
            <field name="model">inventario.fabricante</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                            </group>
                            <group>
                                <field name="logo" widget="image"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="inventario_fabricante_view_list" model="ir.ui.view">
            <field name="name">inventario_fabricante.view.list</field>
            <field name="model">inventario.fabricante</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="inventario_fabricante_action" model="ir.actions.act_window">
            <field name="name">Inventario - Fabricante</field>
            <field name="res_model">inventario.fabricante</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="inventario_fabricante_view_list"/>
        </record>
    </data>
</odoo>