<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_contrato_view_form" model="ir.ui.view">
            <field name="name">inventario.contrato.view.form</field>
            <field name="model">inventario.contrato</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="etapa_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <h1><field name="name" readonly="1"/></h1>
                        <group string="Datos de contrato">
                            <field name="contrato_folio"/>
                            <field name="fecha_inicio"/>
                            <field name="fecha_fin"/>
                            <field name="periodo_arrendamiento"/>
                            <field name="nota"/>
                        </group>
                        <notebook>
                            <page string="Documenación">
                                <group>
                                    <group string="Contrato">
                                        <field name="contrato_attach" widget="pdf_viewer"/>
                                    </group>
                                    <group string="Factura">
                                        <field name="factura_attach" widget="pdf_viewer"/>
                                    </group>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="inventario_contrato_view_list" model="ir.ui.view">
            <field name="name">inventario.contrato.view.list</field>
            <field name="model">inventario.contrato</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                    <field name="fecha_inicio"/>
                    <field name="fecha_fin"/>
                    <field name="periodo_arrendamiento"/>
                    <field name="etapa_id"/>
                </list>
            </field>
        </record>

        <record id="inventario_contrato_action" model="ir.actions.act_window">
            <field name="name">Inventario - Contrato</field>
            <field name="res_model">inventario.contrato</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="inventario_contrato_view_list"/>
        </record>
    </data>
</odoo>