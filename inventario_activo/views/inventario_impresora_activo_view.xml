<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_impresora_view_form" model="ir.ui.view">
            <field name="name">inventario.impresora.view.form</field>
            <field name="model">inventario.impresora.activo</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="etapa_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <h1><field name="name" readonly="1"/></h1>
                        <field name="etapa_baja_id" invisible="1"/>
                        <group string="Estado de baja" invisible="etapa_id != etapa_baja_id">
                            <field name="fecha_baja"/>
                            <field name="motivo_baja"/>
                        </group>
                        <group>
                            <group string="Datos del equipo">
                                <field name="modelo_id"/>
                                <field name="serie"/>
                                <field name="fabricante_id"/>
                                <field name="proveedor_id"/>
                                <field name="ubicacion_id"/>
                                <field name="estatus_id"/>
                                <field name="activo" widget="boolean_toggle"/>
                            </group>
                            <group string="Información de asignación">
                                <field name="empleado_id"/>
                                <field name="puesto_id"/>
                                <field name="fecha_asignacion"/>
                            </group>
                        </group>
                        <group>
                            <group string="Especificaciones">
                                <field name="conectividad_id" widget="radio" options="{'horizontal': true}"/>
                                <field name="ip"/>
                                <field name="adf"/>
                                <field name="color"/>
                                <field name="tipo_consumible_id" widget="radio" options="{'horizontal': true}"/>
                                <field name="modelo_consumible"/>
                            </group>
                            <group string="Observaciones">
                                <field name="obsevacion"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Aquisición">
                                <group>
                                    <field name="fecha_adquisicion"/>
                                    <field name="importe"/>
                                    <field name="iva"/>
                                    <field name="total"/>
                                    <field name="esquema_ad_id"/>
                                    <field name="num_plazos"/>
                                </group>
                            </page>
                            <page string="Garantía">
                                <group>
                                    <field name="tipo_garantia_id"/>
                                    <field name="vigencia"/>
                                    <field name="vigente"/>
                                </group>
                            </page>
                            <page string="Evidencia">
                                <group>
                                    <field name="evidencia_foto"/>
                                </group>
                            </page>
                            <page string="Resguardo">
                                <group>
                                    <field name="resguardo_attach"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="inventario_impresora_view_list" model="ir.ui.view">
            <field name="name">inventario.impresora.view.list</field>
            <field name="model">inventario.impresora.activo</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="serie"/>
                    <field name="modelo_id"/>
                    <field name="etapa_id"/>
                    <field name="fecha_asignacion"/>
                    <field name="empleado_id"/>
                </list>
            </field>
        </record>

        <record id="inventario_impresora_action" model="ir.actions.act_window">
            <field name="name">Impresoras</field>
            <field name="res_model">inventario.impresora.activo</field>
            <field name="view_mode">list,form</field>
            <field name="view_id"  ref="inventario_impresora_view_list"/>
        </record>
    </data>
</odoo>