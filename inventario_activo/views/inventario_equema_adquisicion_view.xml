<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="inventario_esquema_adquisicion_view_form" model="ir.ui.view">
            <field name="name">inventario.esquema.adquisicion.view.form</field>
            <field name="model">inventario.esquema.adquisicion</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="inventario_esquema_adquisicion_view_list" model="ir.ui.view">
            <field name="name">inventario.esquema.adquisicion.view.list</field>
            <field name="model">inventario.esquema.adquisicion</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="inventario_esquema_adquisicion_action" model="ir.actions.act_window">
            <field name="name">Esquema Adquisición</field>
            <field name="res_model">inventario.esquema.adquisicion</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="inventario_esquema_adquisicion_view_list"/>
        </record>
    </data>
</odoo>