<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="whatsapp_chatbot_view_form" model="ir.ui.view">
            <field name="name">whatsapp.chatbot.view.form</field>
            <field name="model">whatsapp.chatbot</field>
            <field name="arch" type="xml">
                <form string="Whatsapp Chatbot">
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button
                                    class="oe_stat_button"
                                    type="action"
                                    invisible="wa_conversation_count == 0"
                                    name="%(odoo_whatsapp_ent_chatbot.discuss_channel_action_from_whatsapp_chatbot)d"
                                    icon="fa-comments"
                            >
                                <field
                                        string="Channel"
                                        name="wa_conversation_count"
                                        widget="statinfo"
                                />
                            </button>
                        </div>
                        <field name="active" invisible="1"/>
                        <widget
                                name="web_ribbon"
                                title="Archived"
                                bg_color="bg-danger"
                                invisible="active == True"
                        />
                        <field
                                name="image_1920"
                                widget="image"
                                class="oe_avatar"
                                options="{'preview_image': 'image_128'}"
                        />
                        <div class="oe_title">
                            <label for="title" string="Chatbot Name"/>
                            <h1>
                                <field
                                        name="title"
                                        default_focus="1"
                                        placeholder='e.g. "Meeting Scheduler Bot"'
                                />
                            </h1>
                        </div>
                        <div string="No Agent Configuration" name="no_operator_configuration">
                            <setting
                                    help="Create a CRM Lead or Helpdesk Ticket when no operator is available or online.">
                                <field name="create_record"/>
                                <field name="record_model_selection" widget="radio" invisible="not create_record"
                                       required="create_record"/>
                            </setting>
                        </div>
                        <notebook>
                            <page string="Script">
                                <field
                                        name="step_type_ids"
                                        widget="chatbot_steps_one2many"
                                >
                                    <list>
                                        <field name="sequence" widget="handle"/>
                                        <field name="step_call_type"/>
                                        <field name="message"/>
                                        <field name="whatsapp_chatbot_id" invisible="1"/>
                                        <field name="parent_id"/>
                                        <field
                                                name="answer"
                                                readonly="step_call_type != 'message'"
                                                required="step_call_type == 'message'"
                                        />
                                        <field
                                                name="template_id"
                                                readonly="step_call_type not in ['template', 'interactive']"
                                                required="step_call_type in ['template', 'interactive']"
                                        />
                                        <button name="add_interactive_line" type="object" class="btn-dark"
                                                icon="fa-plus" title="Add Interactive Line"
                                                help="Clicking this button will create a script from the template and list your selected items."/>
                                        <field
                                                name="action_id"
                                                readonly="step_call_type != 'action'"
                                                required="step_call_type == 'action'"
                                                domain="[('chatbot_id', '=', whatsapp_chatbot_id)]"
                                        />
                                    </list>
                                </field>
                            </page>
                            <page string="Actions">
                                <field
                                        name="action_ids"
                                        widget="chatbot_steps_one2many"
                                >
                                    <list name="Action">
                                        <field name="name"/>
                                        <field name="binding_model_id"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Operators" name="operators">
                                <field name="user_ids">
                                    <kanban class="o_kanban_mobile">
                                        <field name="id"/>
                                        <field name="name"/>
                                        <templates>
                                            <t t-name="card" class="flex-row">
                                                <aside class="o_kanban_aside_full">
                                                    <div class="o_kanban_image">
                                                        <field name="avatar_128" class="w-100 h-auto m-0"
                                                               widget="image"
                                                               options="{'img_class': 'object-fit-contain w-100 h-100'}"/>
                                                    </div>
                                                </aside>
                                                <main class="ps-2">
                                                    <div class="mb-1">
                                                        <field name="complete_name" class="mb-0 fw-bold fs-5"/>
                                                    </div>
                                                </main>
                                            </t>
                                        </templates>
                                    </kanban>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="whatsapp_chatbot_view_list" model="ir.ui.view">
            <field name="name">whatsapp.chatbot.view.list</field>
            <field name="model">whatsapp.chatbot</field>
            <field name="arch" type="xml">
                <list string="Whatsapp Chatbot">
                    <field name="title"/>
                </list>
            </field>
        </record>

        <record id="whatsapp_chatbot_action" model="ir.actions.act_window">
            <field name="name">WhatsApp Chatbot</field>
            <field name="res_model">whatsapp.chatbot</field>
            <field name="view_mode">list,form</field>
        </record>
    </data>

    <menuitem
            id="whatsapp_chatbot_menu"
            name="WhatsApp Chatbot"
            parent="whatsapp.whatsapp_configuration_menu"
            action="whatsapp_chatbot_action"
            sequence="12"
    />

</odoo>
