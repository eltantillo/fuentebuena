<templates xml:space="preserve">
    <t t-name="portal_app.Home">
        <div class="home-view">
            <div class="container vh-100 d-flex align-items-center">
                <div class="row w-100 justify-content-center">
                    <img t-att-src="'/portal_app/static/src/img/pilotea-logo-white.png'"
                                     alt="Logo Pilotea" class="img-fluid" style="max-height: 8rem; max-width: 15rem"/>
                    <h5 class="text-center fw-bold mb-4" style="padding-top: 40px; color: white;">Hola, aquí puedes descargar tus archivos.</h5>
                    <div class="container my-4">
                        <div class="row g-3 justify-content-center row-cols-1">
                            <t t-foreach="state.files" t-as="file" t-key="file.id">
                                <div class="col-11 col-md-8 mx-auto">
                                    <a t-att-href="file.url" t-on-click="(ev) => this.log_poliza(ev, file)" class="card h-100 shadow-sm text-dark hvr-card rounded-4" download="" style="text-decoration: none;">
                                        <div class="card-body d-flex align-items-center p-3">
                                            <div class="bg-success-subtle text-success rounded-4 d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px; flex-shrink: 0;">
                                                <i class="fa fa-file-text-o"/>
                                            </div>
                                            <div class="overflow-hidden w-100">
                                                <h6 class="card-title text-truncate mb-1 fw-bold text-secondary-dark">
                                                    <t t-esc="file.nombre"/>
                                                </h6>
                                                <p class="card-text small text-success fw-medium mb-0 d-flex align-items-center">
                                                    Descargar archivo
                                                    <i class="fa fa-download ms-1 small animate-arrow"/>
                                                </p>
                                            </div>
                                        </div>
                                    </a>
                                </div>
                            </t>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </t>
</templates>