<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="complemento_pago_view_form" model="ir.ui.view">
            <field name="name">complemento.pago.view.form</field>
            <field name="model">complemento.pago</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="PDF de complemento">
                            <field name="pdf" required="1" widget="pdf_viewer"/>
                        </group>
                        <group string="XML de complemento">
                            <field name="xml" required="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="complemento_pago_view_list" model="ir.ui.view">
            <field name="name">complemento.pago.view.form</field>
            <field name="model">complemento.pago</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="pdf"/>
                    <field name="xml"/>
                </list>
            </field>
        </record>

        <record id="complemento_pago_action" model="ir.actions.act_window">
            <field name="name">Complementos de pago</field>
            <field name="res_model">complemento.pago</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="complemento_pago_view_list"/>
        </record>
    </data>
</odoo>