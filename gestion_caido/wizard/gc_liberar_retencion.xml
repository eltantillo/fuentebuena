<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="gc_liberar_retencion_view_form" model="ir.ui.view">
            <field name="name">gc.liberar.retencion.view.form</field>
            <field name="model">gc.liberar.retencion</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <div class="d-flex align-items-center">
                                <div class="alert alert-warning w-100 mb-2" role="alert">
                                    <p>Por favor, proceda con cuidado; los datos serán desvinculados automáticamente.</p>
                                </div>
                            </div>
                        </group>
                        <group>
                            <field name="etapa_destino_id"/>
                            <field name="mostrar_cancelacion" invisible="1"/>
                            <field name="motivo_cancelacion_id" invisible="mostrar_cancelacion"/>
                        </group>
                    </sheet>
                    <footer>
                        <button type="object" name="confirmar" string="Confirmar" class="btn-success text-white" />
                        <button string="Cancelar" special="cancel"  class="btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>