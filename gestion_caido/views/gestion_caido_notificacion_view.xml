<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="gestion_caido_notificacion_view_form" model="ir.ui.view">
            <field name="name">gestion.caido.notificacion.view.form</field>
            <field name="model">gestion.caido.notificacion</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="plaza_ids"/>
                            <field name="correo"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="gestion_caido_notificacion_view_list" model="ir.ui.view">
            <field name="name">gestion.caido.notificacion.view.list</field>
            <field name="model">gestion.caido.notificacion</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="plaza_ids"/>
                    <field name="correo"/>
                </list>
            </field>
        </record>

        <record id="gestion_caido_notificacion_action" model="ir.actions.act_window">
            <field name="name">Gestión Caído - Notificaciones</field>
            <field name="res_model">gestion.caido.notificacion</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="gestion_caido_notificacion_view_list"/>
        </record>
    </data>
</odoo>