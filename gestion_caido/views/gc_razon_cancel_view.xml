<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="gc_razon_cancel_view_form" model="ir.ui.view">
            <field name="name">gc.razon.cancel.view.form</field>
            <field name="model">gestion.caido.razon.cancel</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="gc_razon_cancel_view_list" model="ir.ui.view">
            <field name="name">gc.razon.cancel.view.list</field>
            <field name="model">gestion.caido.razon.cancel</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="gc_razon_cancel_action" model="ir.actions.act_window">
            <field name="name">GC - Razón cancelación</field>
            <field name="res_model">gestion.caido.razon.cancel</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="gc_razon_cancel_view_list"/>
        </record>
    </data>
</odoo>