<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="gestion_caido_estado_view_form" model="ir.ui.view">
            <field name="name">gestion.caido.estado.view.form</field>
            <field name="model">gestion.caido.estado</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="gestion_caido_estado_view_list" model="ir.ui.view">
            <field name="name">gestion.caido.estado.view.list</field>
            <field name="model">gestion.caido.estado</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                    <field name="sequence"/>
                </list>
            </field>
        </record>

        <record id="gestion_caido_estado_action" model="ir.actions.act_window">
            <field name="name">Estado</field>
            <field name="res_model">gestion.caido.estado</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="gestion_caido_estado_view_list"/>
        </record>
    </data>
</odoo>