<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="gc_notificacion_mail_template"  model="mail.template">
            <field name="name">Creación de gestión</field>
            <field name="model_id" ref="model_gestion_caido"/>
            <field name="subject">Se ha creado un proceso de gestión - {{object.id}} / {{object.model_id.name}}</field>
            <field name="body_html">
                <![CDATA[
                    <div style="box-sizing:border-box;font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:14px;background:#ffffff;border-radius:12px;padding:28px;border:1px solid #E6EAF0;box-shadow:0 4px 12px rgba(0,0,0,.05);max-width:620px;margin:0 auto;color:#2C3E50;">
                        <table style="width:100%;border-collapse:collapse;margin-bottom:24px;">
                            <tr>
                                <td>
                                    <img src="https://www.pilotea.mx/assets/landing/branding-imagotipo-horizontal-full-color-lg-4daf4d22a4a6126e02a1a044434584002e58ad2d9c51dec50de8cc2914a83a86.svg"
                                         alt="Pilotea"
                                         style="height:44px;width:auto;display:block;"/>
                                </td>
                            </tr>
                        </table>
                        <div style="text-align:center;margin-bottom:30px;">
                            <div style="display:inline-flex;align-items:center;gap:10px;background:#F8F9FB;border:1px solid #E6EAF0;border-radius:30px;padding:8px 14px;">
                                <span style="color:#5B6472;font-size:14px;font-weight:600;">
                                    Estado:
                                </span>
                                <span style="background:#283a3e;color:#FFF;border-radius:20px;padding:6px 16px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;">
                                    <t t-out="object.estado_id.name"/>
                                </span>
                            </div>
                        </div>
                        <div style="margin-bottom:28px;background:#FAFBFC;border:1px solid #EEF2F6;border-radius:10px;padding:18px;">
                            <div style="font-size:16px;font-weight:700;color:#091124;padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid #E6EAF0;">
                                📋 Datos de gestión
                            </div>
                            <table style="width:100%;border-collapse:collapse;">
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Gestor
                                    </td>
                                    <td style="padding:10px 0;text-align:right;font-weight:700;color:#091124;">
                                        <t t-out="object.gestor_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Gestión
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <span style="background:#283a3e;color:white;padding:5px 14px;border-radius:15px;font-size:12px;font-weight:700;">
                                            <t t-out="object.gestion_activa"/>
                                        </span>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin-bottom:28px;background:#FAFBFC;border:1px solid #EEF2F6;border-radius:10px;padding:18px;">
                            <div style="font-size:16px;font-weight:700;color:#091124;padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid #E6EAF0;">
                                🚗 Información del vehículo
                            </div>
                            <table style="width:100%;border-collapse:collapse;">
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Vehículo
                                    </td>
                                    <td style="padding:10px 0;text-align:right;font-weight:700;">
                                        <t t-out="object.vehiculo_id.display_name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Modelo
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.model_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Versión
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.version_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        VIN
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.vin_sn"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Plaza
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.plaza_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Producto
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.producto_id.name"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="margin-bottom:28px;background:#FAFBFC;border:1px solid #EEF2F6;border-radius:10px;padding:18px;">
                            <div style="font-size:16px;font-weight:700;color:#091124;padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid #E6EAF0;">
                                📄 Datos del contrato
                            </div>
                            <table style="width:100%;border-collapse:collapse;">
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Número de contrato
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.num_contrato"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Arrendatario
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.arrendatario_id.name or object.nombre_arrendatario"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        CIE
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.cie"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                        <div style="background:#FAFBFC;border:1px solid #EEF2F6;border-radius:10px;padding:18px;">
                            <div style="font-size:16px;font-weight:700;color:#091124;padding-bottom:10px;margin-bottom:12px;border-bottom:1px solid #E6EAF0;">
                                👤 Datos del conductor
                            </div>
                            <table style="width:100%;border-collapse:collapse;">
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Nombre
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.cliente_id.name"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Correo
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.correo_cliente"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="padding:10px 0;color:#6B7280;font-weight:600;">
                                        Teléfono
                                    </td>
                                    <td style="padding:10px 0;text-align:right;">
                                        <t t-out="object.telefono_cliente"/>
                                    </td>
                                </tr>
                            </table>
                        </div>
                    </div>
                ]]>
            </field>
        </record>
    </data>
</odoo>