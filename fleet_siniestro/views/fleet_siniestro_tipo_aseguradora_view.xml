<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_siniestro_tipo_aseguradora_view_form" model="ir.ui.view">
            <field name="name">fleet.siniestro.tipo.aseguradora.view.form</field>
            <field name="model">fleet.siniestro.tipo.aseguradora</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="id"/>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="fleet_siniestro_tipo_aseguradora_view_list" model="ir.ui.view">
            <field name="name">fleet.siniestro.tipo.aseguradora.view.list</field>
            <field name="model">fleet.siniestro.tipo.aseguradora</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="fleet_siniestro_tipo_aseguradora_action" model="ir.actions.act_window">
            <field name="name">Tipo de aseguradora - Siniestro</field>
            <field name="res_model">fleet.siniestro.tipo.aseguradora</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="fleet_siniestro_tipo_aseguradora_view_list"/>
        </record>
    </data>
</odoo>