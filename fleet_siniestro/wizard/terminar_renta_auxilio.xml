<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_siniestro_terminar_renta_auxilio_form" model="ir.ui.view">
            <field name="name">fleet.siniestro.terminar.renta.auxilio.form</field>
            <field name="model">terminar.renta.auxilio</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="etapa_disponible" invisible="1" readonly="1"/>
                            <div class="d-flex align-items-center">
                                <div class="alert alert-warning w-100 mb-2" role="alert">
                                    <p>Por favor, proceda con cuidado; los datos serán desvinculados automáticamente.</p>
                                </div>
                            </div>
                        </group>
                    </sheet>
                    <footer>
                        <button type="object" name="action_terminar_renta_auxilio" string="Confirmar" class="btn-success text-white" />
                        <button string="Cancelar" special="cancel"  class="btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>