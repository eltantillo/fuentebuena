<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_finanza_asignar_view_form" model="ir.ui.view">
            <field name="name">fleet.finanza.asignar.view.form</field>
            <field name="model">fleet.finanza.asignar</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group string="Seleccione los vehículos">
                            <field name="vehicle_ids" widget="many2many_tags"/>
                        </group>
                        <group string="Información de fondeo">
                            <field name="fuente_fodeo_id"/>
                            <field name="sesionario_id"/>
                        </group>
                    </sheet>
                    <footer>
                        <button type="object" name="action_confirm" string="Confirmar" class="btn-success text-white" />
                        <button string="Cancelar" special="cancel"  class="btn-danger"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>

    <record id="fleet_finanza_asignar_action" model="ir.actions.act_window">
        <field name="name">Registro de fondeo</field>
        <field name="res_model">fleet.finanza.asignar</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fleet_finanza_asignar_view_form"/>
        <field name="target">new</field>
    </record>
</odoo>