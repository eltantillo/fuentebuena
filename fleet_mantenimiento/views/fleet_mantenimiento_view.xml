<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_mantenimiento_view_form" model="ir.ui.view">
            <field name="name">fleet.mantenimiento.view.form</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <field name="etapa_id" widget="statusbar" options="{'clickable': '1'}"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Datos de mantenimiento" name="data_mantenimiento">
                                <field name="mostrar_tipo_mant_serv" invisible="1"/>
                                <field name="mostrar_servicios" invisible="1"/>
                                <field name="fecha_programado" required="1"/>
                                <field name="proveedor_id"/>
                                <field name="folio"/>
                                <field name="tipo_mantenimiento_id" required="1"/>
                                <field name="tipo_mantenimiento_servicio_id" domain="[('mantenimiento_tipo_id', '=', tipo_mantenimiento_id)]" invisible="mostrar_tipo_mant_serv"/>
                                <field name="categoria_mante_servicio_id" invisible="mostrar_tipo_mant_serv"/>
                                <field name="servicios_ids" widget="many2many_list" invisible="mostrar_servicios"/>
                                <field name="indicador_actualizacion"/>
                                <field name="observacion"/>
                            </group>
                            <group string="Importes" name="data_importe">
                                <field name="importe"/>
                                <field name="iva" readonly="1"/>
                                <field name="total" readonly="1"/>
                            </group>
                        </group>
                        <group string="Fechas de mantenimiento" name="data_fechas">
                                <field name="fecha_deteccion"/>
                                <field name="km_deteccion"/>
                                <field name="fecha_hora_entrada"/>
                                <field name="km_entrada"/>
                                <field name="fecha_hora_salida"/>
                        </group>
                        <group>
                            <group string="Información del vehiculo" name="data_vehiculo">
                                <field name="vehiculo_id" required="1"/>
                                <field name="vin_sn" readonly="1"/>
                                <field name="numero_economico" readonly="1"/>
                                <field name="producto_id" readonly="1"/>
                                <field name="plaza_id" readonly="1"/>
                            </group>
                            <group string="Información del conductor" name="data_conductor">
                                <field name="conductor_id" readonly="1"/>
                                <field name="conductor_email" readonly="1"/>
                                <field name="conductor_telefono" readonly="1"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Expediente" name="expediente">
                                <group>
                                    <group>
                                        <field name="expediente_digital" widget="pdf_viewer"/>
                                    </group>
                                    <group>
                                        <field name="expediente_fotografico" widget="image"/>
                                    </group>
                                </group>
                            </page>
                            <page string="Factura" name="factura">
                                <group>
                                    <field name="numero_factura"/>
                                    <field name="fecha_factura"/>
                                </group>
                                <group string="Factura">
                                    <field name="expediente_factura" widget="pdf_viewer"/>
                                </group>
                                <group string="XML">
                                    <field name="expediente_digital_xml"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="fleet_mantenimiento_view_list" model="ir.ui.view">
            <field name="name">fleet.mantenimiento.view.list</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="plaza_id"/>
                    <field name="vehiculo_id"/>
                    <field name="vin_sn"/>
                    <field name="tipo_mantenimiento_servicio_id"/>
                    <field name="km_entrada"/>
                    <field name="importe"/>
                    <field name="total"/>
                    <field name="numero_factura"/>
                    <field name="fecha_factura"/>
                    <field name="fecha_hora_entrada"/>
                    <field name="proveedor_id"/>
                    <field name="tipo_mantenimiento_id"/>
                    <field name="etapa_id"/>
                    <field name="categoria_mante_servicio_id"/>
                </list>
            </field>
        </record>

        <record id="fleet_mantenimiento_view_kanban" model="ir.ui.view">
            <field name="name">fleet.mantenimiento.view.kanban</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="arch" type="xml">
                <kanban default_group_by="etapa_id" class="o_kanban_example">
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <strong><field name="rec_name"/></strong>
                                <div><field name="vin_sn"/></div>
                                <div><field name="plaza_id"/></div>
                                <div><field name="tipo_mantenimiento_id"/></div>
                                <div><field name="tipo_mantenimiento_servicio_id"/></div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="fleet_mantenimiento_view_pivot" model="ir.ui.view">
            <field name="name">fleet.mantenimiento.view.pivot</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="arch" type="xml">
                <pivot string="Análisis de Mantenimientos">
                    <field name="importe" type="measure"/>
                    <field name="total" type="measure"/>
                    <field name="km_entrada" type="measure"/>
                    <field name="plaza_id" type="row"/>
                    <field name="tipo_mantenimiento_id" type="row"/>
                    <field name="proveedor_id" type="row"/>
                    <field name="fecha_hora_entrada" type="col" interval="month"/>
                </pivot>
            </field>
        </record>

        <record id="fleet_mantenimiento_view_search" model="ir.ui.view">
            <field name="name">fleet.mantenimiento.view.search</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="arch" type="xml">
                <search string="All vehicles">
                    <field string="VIN/sn" name="vin_sn" filter_domain="[('vin_sn', 'ilike', self)]"/>
                    <filter string="Archivados" name="archivado" domain="[('active', '=', False)]"/>
                    <field string="Plaza" name="plaza_id"/>
                    <field string="Producto" name="producto_id"/>
                    <separator/>
                    <filter string="Mantenimiento Menor A" name="categoria_a" domain="[('tipo_mantenimiento_servicio_id.categoria_id.name', '=', 'Mantenimiento Menor A')]" />
                    <filter string="Mantenimiento Medio B" name="categoria_b" domain="[('tipo_mantenimiento_servicio_id.categoria_id.name', '=', 'Mantenimiento Medio B')]" />
                    <filter string="Mantenimiento Mayor C" name="categoria_c" domain="[('tipo_mantenimiento_servicio_id.categoria_id.name', '=', 'Mantenimiento Mayor C')]" />
                    <separator/>
                    <filter string="Plaza - Puebla" name="plaza_puebla" domain="[('plaza_id.name', '=', 'Puebla')]" />
                    <filter string="Plaza - Monterrey" name="plaza_monterrey" domain="[('plaza_id.name', '=', 'Monterrey')]" />
                    <filter string="Plaza - Queretaro" name="plaza_queretaro" domain="[('plaza_id.name', '=', 'Queretaro')]" />
                    <filter string="Plaza - León" name="plaza_leon" domain="[('plaza_id.name', '=', 'León')]" />
                    <filter string="Plaza - Guadalajara" name="plaza_guadalajara" domain="[('plaza_id.name', '=', 'Guadalajara')]" />
                    <separator/>
                    <filter string="Vehícular Preventivo" name="v_preventivo" domain="[('tipo_mantenimiento_id.name','=', 'Vehicular Preventivo')]"/>
                    <filter string="Vehicular Correctivo" name="v_correctivo" domain="[('tipo_mantenimiento_id.name','=', 'Vehicular Correctivo')]"/>
                    <filter string="GNV Preventivo" name="gnv_preventivo" domain="[('tipo_mantenimiento_id.name','=', 'GNV Preventivo')]"/>
                    <filter string="Inspección" name="inspeccion" domain="[('tipo_mantenimiento_id.name','=', 'Inspección')]"/>
                    <filter string="GNV Dictamen" name="gnv_dictamenn" domain="[('tipo_mantenimiento_id.name','=', 'GNV Dictamen')]"/>
                    <filter string="GNV Correctivo" name="gnv_correctivo" domain="[('tipo_mantenimiento_id.name','=', 'GNV Correctivo')]"/>
                    <filter string="Vehicular Rehabilitación" name="v_rehabilitacion" domain="[('tipo_mantenimiento_id.name','=', 'Vehicular Rehabilitación')]"/>
                    <filter string="Daño Operativo" name="dano_operativo" domain="[('tipo_mantenimiento_id.name','=', 'Daño Operativo')]"/>
                    <separator/>
                    <group>
                        <filter string="Etapa" name="groupby_etapa" context="{'group_by': 'etapa_id'}"/>
                        <filter string="Categoría" name="groupby_categoria" context="{'group_by': 'categoria_mante_servicio_id'}"/>
                        <filter string="Tipo mantenimiento" name="groupby_tipo_mante" context="{'group_by': 'tipo_mantenimiento_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="fleet_mantenimiento_view_graph" model="ir.ui.view">
            <field name="name">fleet.mantenimiento.view.graph</field>
            <field name="model">fleet.mantenimiento</field>
            <field name="arch" type="xml">
                <graph string="Análisis de Mantenimientos" type="bar">
                    <field name="total" type="measure"/>
                    <field name="importe" type="measure"/>
                    <field name="plaza_id" type="row"/>
                    <field name="tipo_mantenimiento_id" type="col"/>
                    <field name="fecha_hora_entrada" type="col" interval="month"/>
                </graph>
            </field>
        </record>

        <record id="fleet_mantenimiento_action" model="ir.actions.act_window">
            <field name="name">Mantenimientos</field>
            <field name="res_model">fleet.mantenimiento</field>
            <field name="view_mode">kanban,list,form,pivot,graph</field>
        </record>
    </data>
</odoo>