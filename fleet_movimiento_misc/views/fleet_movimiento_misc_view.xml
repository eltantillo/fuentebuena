<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="fleet_movimiento_misc_view_form" model="ir.ui.view">
            <field name="name">fleet.movimiento.misc.view.form</field>
            <field name="model">fleet.movimiento.misc</field>
            <field name="arch" type="xml">
                <form>
                    <header>
                        <button name="action_pago" type="object" string="Realizar pago" class="btn-success text-white" invisible="1"/>
                        <field name="etapa_id" widget="statusbar" options="{'clickable': True}"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Datos del movimiento" name="data_movimiento">
                                <field name="fecha_registro" required="1"/>
                                <field name="fecha_movimiento"  required="1"/>
                                <field name="fecha_vencimiento"/>
                                <field name="tipo_movimiento_id" required="1"/>
                                <field name="folio"/>
                                <field name="motivo_id" required="1"/>
                                <field name="conductor_id" required="1"/>
                                <field name="estado_id" required="1"/>
                                <field name="estado_code" invisible="1"/>
                                <field name="municipio_id" domain="[('code', '=', estado_code)]" invisible="estado_code == False" required="1"/>
                                <field name="descripcion"/>
                            </group>
                            <group string="Importes" name="data_importe">
                                <field name="importe"/>
                                <field name="aplica_iva"/>
                                <field name="iva" readonly="1"/>
                                <field name="total" readonly="1"/>
                                <field name="folio_factura"/>
                                <field name="importe_pagado" readonly="1"/>
                                <field name="importe_pendiente" readonly="1"/>
                                <field name="fecha_ultimo_pago" readonly="1"/>
                            </group>
                        </group>
<!--                        <group string="Contrato" name="data_contrato">-->
<!--                            <field name="contrato_id" domain="[('vehicle_id', '=', vehiculo_id)]"/>-->
<!--                            <field name="cliente_id" readonly="1" string="Arrendatario"/>-->
<!--                        </group>-->
                        <group string="Proveedor" name="data_proveedor">
                            <field name="proveedor_id"/>
                            <field name="proveedor_telefono" widget="phone"/>
                        </group>
                        <group string="Información del vehículo" name="data_vehiculo">
                            <field name="vehiculo_id" required="1"/>
                            <field name="contrato_id" domain="[('vehicle_id', '=', vehiculo_id)]" required="1"/>
                            <field name="cliente_id" readonly="1" string="Arrendatario"/>
                            <field name="matricula" readonly="1"/>
                            <field name="numero_economico" readonly="1"/>
                            <field name="vin_sn" readonly="1"/>
                            <field name="producto_id" readonly="1"/>
                            <field name="plaza_id" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Expediente" name="expediente">
                                <field name="attach_movimiento" widget="pdf_viewer"/>
                            </page>
                        </notebook>
                    </sheet>
                    <chatter/>
                </form>
            </field>
        </record>

        <record id="fleet_movimiento_misc_view_list" model="ir.ui.view">
            <field name="name">fleet.movimiento.misc.view.list</field>
            <field name="model">fleet.movimiento.misc</field>
            <field name="arch" type="xml">
                <list>
                    <field name="id"/>
                    <field name="fecha_movimiento"/>
                    <field name="contrato_id"/>
                    <field name="tipo_movimiento_id"/>
                    <field name="motivo_id"/>
                    <field name="descripcion"/>
                    <field name="importe"/>
                    <field name="importe_pendiente"/>
                    <field name="write_date" string="Ultima actualización"/>
                </list>
            </field>
        </record>

        <record id="fleet_movimiento_misc_view_search" model="ir.ui.view">
            <field name="name">fleet.movimiento.misc.view.search</field>
            <field name="model">fleet.movimiento.misc</field>
            <field name="arch" type="xml">
                <search string="All vehicles">
                    <field string="VIN/sn" name="vin_sn" filter_domain="[('vin_sn', 'ilike', self)]"/>
                    <field string="Matricula" name="matricula" filter_domain="[('matricula', 'ilike', self)]"/>
                    <filter string="Archivados" name="archivado" domain="[('active', '=', False)]"/>
                    <filter string="Plaza - Puebla" name="plaza_puebla" domain="[('plaza_id.name', '=', 'Puebla')]" />
                    <filter string="Plaza - Monterrey" name="plaza_monterrey" domain="[('plaza_id.name', '=', 'Monterrey')]" />
                    <filter string="Plaza - Queretaro" name="plaza_queretaro" domain="[('plaza_id.name', '=', 'Queretaro')]" />
                    <filter string="Plaza - León" name="plaza_leon" domain="[('plaza_id.name', '=', 'León')]" />
                    <filter string="Plaza - Guadalajara" name="plaza_guadalajara" domain="[('plaza_id.name', '=', 'Guadalajara')]" />
                    <separator/>
                    <group>
                        <filter string="Etapa" name="groupby_etapa" context="{'group_by': 'etapa_id'}"/>
                        <filter string="Plaza" name="groupby_plaza" context="{'group_by': 'plaza_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="fleet_movimiento_misc_action" model="ir.actions.act_window">
            <field name="name">Movimientos</field>
            <field name="res_model">fleet.movimiento.misc</field>
            <field name="view_mode">list,form,search</field>
            <field name="view_id" ref="fleet_movimiento_misc_view_list"/>
        </record>
    </data>
</odoo>