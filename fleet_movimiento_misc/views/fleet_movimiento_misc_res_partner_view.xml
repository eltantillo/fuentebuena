<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="res_partner_form_view_fleet_movimiento_misc" model="ir.ui.view">
            <field name="name">res.partner.form.view.fleet.movimiento.misc</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_view_fleet_movimiento_misc" type="object" class="oe_stat_button" icon="fa-legal">
                        <field name="fleet_movimiento_misc_count" widget="statinfo" string="Movimientos"/>
                    </button>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
